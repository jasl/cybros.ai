source "https://rubygems.org"

# Specify this gem's dependencies in rho-acp-client.gemspec.
gemspec

gem "cmctl", path: "../../../cmctl"

# rho, the runner, the SDK and the agent gem ride alongside in this
# monorepo; released versions come from rubygems once the gems cut
# releases.
gem "rho", path: "../rho"
gem "cybros_agent", path: "../../../sdks/ruby"
gem "rho-runner", path: "../rho-runner"
gem "rho-acp", path: "../rho-acp"

# The development group: a checkout's suite, never an installed prefix's
# (the installer runs `--without development test`).
# The suite runs over rho's test support tree (`test/test_helper.rb`
# requires it by relative path).
group :development do
  gem "rake", "~> 13.0"

  gem "minitest", "~> 6.0"

  gem "rbs", require: false
  gem "rubocop", "~> 1.21", require: false
  gem "rubocop-rails-omakase", require: false
end
