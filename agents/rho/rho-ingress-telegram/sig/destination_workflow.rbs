module Rho
  module IngressTelegram
    module DestinationWorkflow
      def destination_list: (Update update, String argument) -> String
      def deliver_task: (Update update, String argument) -> String
    end
    class Runtime
      include DestinationWorkflow
    end
    class Bridge
