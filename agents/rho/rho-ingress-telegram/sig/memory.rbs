module Rho
  module IngressTelegram
    module MemoryBridge
      def memory: (String conversation_id, action: Rho::MemoryCommands::Action, workspace_public_id: String, speaker_public_id: String) -> String
      def participation_memory: (String conversation_id, model: String, workspace_public_id: String, speaker_public_id: String) -> String?
    end
    class Bridge
      include MemoryBridge
    end
    module MemoryWorkflow
      def memory_command: (Update update, String argument) -> String
    end
    class Runtime
      include MemoryWorkflow
    end
  end
end
