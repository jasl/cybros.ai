module Rho
  module IngressTelegram
    class Bridge
      include ScheduleBridge
      ATTENTION_LIMIT: Integer
      QUESTION_LIMIT: Integer
      def initialize: (host: untyped, ?core: untyped, ?agent_public_id: String?) -> void
      def bot_detail: () -> document
      def bot_history: (?after: String?, ?limit: Integer?, ?archived: bool?) -> document
      def ensure_bot_current: (operation_id: String) -> document
      def new_bot_conversation: (operation_id: String, ?home_workspace_public_id: String?) -> document
      def resume_bot_conversation: (operation_id: String, conversation_public_id: String, workspace_public_id: String) -> document
      def fork_bot_conversation: (operation_id: String, conversation_public_id: String, workspace_public_id: String,
        turn_public_id: String, ?variant_public_id: String?) -> document
      def bot_audience: () -> String
      def worker_answerer: (Hash[String, untyped] source, workspace_public_id: String) -> String?
      def workspace_state: () -> Hash[String, untyped]
      def workspaces: () -> Array[Hash[String, untyped]]
      def workspace: (String public_id) -> Hash[String, untyped]
      def create_workspace: (name: String, idempotency_key: String) -> Hash[String, untyped]
      def default_workspace: () -> Hash[String, untyped]
      def conversation_workspace: (String conversation_id) -> Hash[String, untyped]
      def conversation_workspace_id: (String conversation_id) -> String
      def conversation: (String conversation_id, ?workspace_public_id: String?) -> Hash[String, untyped]
      def attach: (String conversation_id, workspace_public_id: String) -> untyped
      def inputs: (String conversation_id, ?workspace_public_id: String?) -> Array[Hash[String, untyped]]
      def update_input: (String conversation_id, String input_id, ?text: String?, ?schedule: Hash[String, String], workspace_public_id: String) -> untyped
      def delete_input: (String conversation_id, String input_id, workspace_public_id: String) -> untyped
      def submit: (String conversation_id, text: String, speaker: String, idempotency_key: String,
                   ?mode: String, ?observe: bool, ?model: String?, ?approval_mode: String?, ?tool_names: Array[String]?,
                   ?workspace_public_id: String?, ?upload_public_ids: Array[String],
                   ?expected_steering_run_public_id: String?, ?inline: Array[Hash[String, untyped]]?, ?deliver_at: String?) -> untyped
      def observation: (String conversation_id, workspace_public_id: String) -> String?
      def participation_model: () -> String?
      def participation_context: (String conversation_id, latest_input_id: String, position: Hash[String, untyped], workspace_public_id: String) -> String?
      def participation_start: (prompt: String, model: String, configuration: Hash[String, untyped], idempotency_key: String, workspace_public_id: String) -> Hash[String, untyped]
      def participation: (id: String, workspace_public_id: String) -> Hash[String, untyped]
      def cancel_participation: (id: String, workspace_public_id: String) -> nil
      def record_participation: (String conversation_id, text: String, idempotency_key: String, workspace_public_id: String) -> String
      def register_speaker: (user: Hash[String, untyped], ?owner: bool) -> String
      def turns: (String conversation_id, ?after_position: Integer?, ?workspace_public_id: String?) -> Array[Hash[String, untyped]]
      def turn_source: (String conversation_id, position: Integer, ?workspace_public_id: String?) -> Hash[String, untyped]?
      def worker_request: (String conversation_id, workspace_public_id: String) -> Hash[String, untyped]?
      def worker_result: (Hash[String, untyped] source, workspace_public_id: String) -> Hash[String, untyped]?
      def turn_media: (Hash[String, untyped] turn, workspace_public_id: String) -> Array[Hash[String, untyped]]
      def stage_media: (bytes: String, filename: String, content_type: String, idempotency_key: String, workspace_public_id: String) -> String
      def transcribe: (upload_public_id: String, model: String, idempotency_key: String, workspace_public_id: String) -> Hash[String, untyped]
      def transcription: (id: String, workspace_public_id: String) -> Hash[String, untyped]
      def speech_start: (text: String, model: String, idempotency_key: String, workspace_public_id: String) -> Hash[String, untyped]
      def speech: (id: String, workspace_public_id: String) -> Hash[String, untyped]
      def cancel_media: (id: String, workspace_public_id: String) -> nil
      def media_bytes: (Hash[String, untyped] descriptor, workspace_public_id: String) -> String
      def runs: () -> Hash[String, Hash[String, untyped]]
      def progress: (Hash[String, untyped] run) -> Hash[String, untyped]
      def snapshot: (String conversation_id, ?workspace_public_id: String?, ?run: Hash[String, untyped]?, ?inputs: Array[Hash[String, untyped]]?) -> Hash[String, untyped]
      def task_execution: (String run_id, workspace_public_id: String) -> Hash[String, untyped]
      def events: (String conversation_id, ?after: String?, ?workspace_public_id: String?) -> Hash[String, untyped]
      def pending: (String conversation_id, ?workspace_public_id: String?, ?reads: Hash[Symbol, untyped]?) -> Array[Hash[String, untyped]]
      def models: () -> Array[String]
      def stop: (String id, ?host_type: String, ?workspace_public_id: String?) -> untyped
      def approve: (String run_id, String key, ?workspace_public_id: String?) -> untyped
      def deny: (String run_id, String key, ?reason: String?, ?workspace_public_id: String?) -> untyped
      def answer: (String run_id, String key, String text, ?workspace_public_id: String?) -> untyped

    end
  end
end
