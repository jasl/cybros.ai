module Rho
  module IngressTelegram
    class Configuration
      class Prepared < Data
        attr_reader operations: Array[document]
        attr_reader enabled: bool
        attr_reader token: String?
        attr_reader bot: document?
        attr_reader agent_public_id: String?
        attr_reader connection_public_id: String?
        def self.new: (operations: Array[document], enabled: bool, token: String?, bot: document?, agent_public_id: String?, connection_public_id: String?) -> instance
      end
      def initialize: (config: Rho::Config, ?clients: untyped) -> void
      def prepare: (document input, agent_public_id: String) -> Prepared
      def prepare_connection: (document input, ?connection_public_id: String?, ?bot_id: String?, ?verify: bool) -> Prepared
      def identify: (String token, ?bot_id: String?) -> document
    end

    class Setup
      def initialize: (home: untyped, prompt: untyped, ?clients: untyped, ?core: untyped) -> void
      def run: (?finish: bool) -> bool
    end
  end
end
