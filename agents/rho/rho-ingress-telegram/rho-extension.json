{
  "id": "rho.ingress_telegram",
  "display_name": "Telegram",
  "category": "channels",
  "description": "Chat with the agent through a Telegram bot, with access controls and conversation routing.",
  "configuration_version": 1,
  "configuration_schema": {
    "type": "object",
    "properties": {
      "connections": {
        "type": "object",
        "default": {},
        "additionalProperties": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "default": "Telegram"
            },
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "token": {
              "type": [
                "string",
                "null"
              ],
              "writeOnly": true,
              "title": "Bot token"
            }
          },
          "additionalProperties": false
        }
      },
      "bots": {
        "type": "object",
        "default": {},
        "additionalProperties": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false,
              "title": "Bot enabled"
            },
            "owner_id": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[1-9][0-9]*$",
              "title": "Owner user ID"
            },
            "stale_after": {
              "type": "integer",
              "minimum": 1,
              "default": 600,
              "title": "Stale message age in seconds"
            },
            "input_debounce_seconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10,
              "default": 2,
              "title": "Message grouping delay in seconds",
              "description": "Wait 0\u201310 seconds before submitting consecutive text together; each new message restarts the wait. Zero sends immediately."
            },
            "transcription_model": {
              "type": "string",
              "default": ""
            },
            "speech_model": {
              "type": "string",
              "default": ""
            },
            "connection_public_id": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid",
              "title": "Connection"
            },
            "target": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "chat_id": {
                  "type": "string",
                  "pattern": "^-?[0-9]+$",
                  "title": "Chat ID"
                },
                "topic_id": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1,
                  "title": "Topic ID"
                }
              },
              "required": [
                "chat_id"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": false
  },
  "default_enabled": false,
  "modes": [
    "full",
    "agent"
  ],
  "requires": [],
  "restart_only": false
}
