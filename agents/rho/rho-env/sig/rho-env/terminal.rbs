module Rho
  module Env
    module Extensions
      module Terminal
        NAME: String
        def self.register: (Api api) -> untyped
      end
    end
    module Tools
      class Terminal
        NAME: String
        DESCRIPTION: nil
        SCHEMA: Hash[String, untyped]
        EFFECT_PROFILE: Hash[String, untyped]
        def self.configured: (executable: String, servers: Array[Hash[String, untyped]]) -> singleton(Terminal)
        def initialize: (env: ToolEnv, executable: String, ?servers: Array[Hash[String, untyped]]) -> void
        def call: (Hash[String, untyped]) -> Result
        class Shell
          def initialize: (root: String) -> void
          def read: () -> (String | :wait_readable | nil)
          def write: (String, context: ExecutionContext) -> Integer
          def cancel: () -> untyped
          def close: () -> void
        end
      end
    end
  end
end
