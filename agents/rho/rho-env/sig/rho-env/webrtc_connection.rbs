module Rho
  module Env
    class WebrtcConnection
      def initialize: (executable: String, context: ExecutionContext, ?servers: Array[Hash[String, untyped]], ?network: WebrtcTransport::Network, ?clock: ^() -> Numeric) -> void
      attr_reader connection_id: String?
      def pid: () -> Integer?
      def poll: () -> WebrtcTransport::Poll
      def send_bytes: (String) -> bool
      def close: () -> nil
    end
  end
end
