module Rho
  class HostPolicy
    NAMESPACE: String
    KEY: String
    KEEP: Object

    class Snapshot < ::Data
      attr_reader owner_public_id: String
      attr_reader host_public_id: String
      attr_reader model: String?
      attr_reader code_mode: bool?
      attr_reader notes: Hash[String, untyped]
      def self.new: (owner_public_id: String, host_public_id: String, model: String?, notes: Hash[String, untyped], ?code_mode: bool?) -> instance
      def self.from_h: (Hash[String, untyped] value) -> instance
      def with: (?owner_public_id: String, ?host_public_id: String, ?model: String?, ?notes: Hash[String, untyped], ?code_mode: bool?) -> instance
      def to_h: () -> Hash[String, untyped]
    end

    def initialize: (store: ^() -> untyped, owner_public_id: String, host_public_id: String) -> void
    def read: () -> Snapshot?
    def replace: (?model: String?, ?notes: Hash[String, untyped], ?code_mode: bool?) -> Snapshot
    def change: (?model: untyped, ?notes: untyped, ?code_mode: untyped) -> Snapshot
  end
end
