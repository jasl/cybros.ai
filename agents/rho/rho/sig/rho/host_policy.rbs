module Rho
  class HostPolicy
    NAMESPACE: String
    KEY: String
    KEEP: Object

    class Snapshot < ::Data
      attr_reader owner_public_id: String
      attr_reader host_public_id: String
      attr_reader model: String?
      attr_reader model_selection: Hash[String, untyped]?
      attr_reader code_mode: bool
      attr_reader subagent: bool
      attr_reader title_pending: bool
      attr_reader title_input_public_id: String?
      attr_reader notes: Hash[String, untyped]
      def self.new: (owner_public_id: String, host_public_id: String, model: String?, notes: Hash[String, untyped], ?code_mode: bool, ?subagent: bool, ?model_selection: Hash[String, untyped]?, ?title_pending: bool, ?title_input_public_id: String?) -> instance
      def self.from_h: (Hash[String, untyped] value) -> instance
      def with: (?owner_public_id: String, ?host_public_id: String, ?model: String?, ?notes: Hash[String, untyped], ?code_mode: bool, ?subagent: bool, ?model_selection: Hash[String, untyped]?, ?title_pending: bool, ?title_input_public_id: String?) -> instance
      def to_h: () -> Hash[String, untyped]
    end

    def initialize: (store: ^() -> untyped, owner_public_id: String, host_public_id: String) -> void
    def read: () -> Snapshot?
    def replace: (?model: String?, ?notes: Hash[String, untyped], ?code_mode: bool, ?subagent: bool, ?model_selection: Hash[String, untyped]?, ?title_pending: bool) -> Snapshot
    def consume_title: (String input_public_id) -> bool
    def change: (?model: untyped, ?notes: untyped, ?code_mode: untyped, ?subagent: untyped, ?model_selection: untyped) -> Snapshot
  end
end
