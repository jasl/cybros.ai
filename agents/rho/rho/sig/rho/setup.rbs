module Rho
  module Cli
    class Setup
      def initialize: (cli: untyped, ?nexus_url: String?, ?public_url: String?, ?input: untyped, ?output: untyped,
        ?error: untyped, ?env: untyped, ?prompt: untyped, ?provider_setup: untyped, ?telegram_setup: untyped) -> void
      def run: (?String? section, ?finish: bool) -> bool
    end
  end

  module Extensions
    module Setup
      NAME: String
      def self.register: (untyped api) -> untyped

    end
  end
end
