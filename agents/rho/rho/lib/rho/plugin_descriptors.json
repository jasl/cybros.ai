    "id": "rho.checkpoints",
    "display_name": "Checkpoints",
    "description": "Capture workspace file changes so a conversation can restore an earlier state.",
    "configuration_version": 1,
    "configuration_schema": {
      "type": "object",
      "properties": {
        "retention_days": {
          "type": "integer",
          "minimum": 1,
          "default": 7
        },
        "max_file_bytes": {
          "type": "integer",
          "minimum": 1,
          "default": 2097152
        },
        "max_tree_bytes": {
          "type": "integer",
          "minimum": 1,
          "default": 268435456
        },
        "capture_timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "default": 30
        }
      },
      "additionalProperties": false
    },
    "default_enabled": true,
    "modes": [
