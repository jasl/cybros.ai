    "id": "rho.lifecycle_hooks",
    "display_name": "Lifecycle Hooks",
    "description": "Run configured tools at conversation and turn lifecycle events.",
    "configuration_version": 1,
    "configuration_schema": {
      "type": "object",
      "properties": {
        "turn_start": {
          "type": "object",
          "properties": {
            "tool": {
              "type": "string",
              "minLength": 1
            },
            "timeout_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300000
            }
          },
          "required": [
            "tool",
            "timeout_ms"
          ],
          "additionalProperties": false,
          "x-rho-atomic": true
        },
        "pre_compact": {
          "type": "object",
          "properties": {
            "tool": {
