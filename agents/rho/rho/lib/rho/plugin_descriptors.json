            "timeout_ms"
          ],
          "additionalProperties": false,
          "x-rho-atomic": true
        },
        "post_compact": {
          "type": "object",
          "properties": {
            "tool": {
              "type": "string",
              "minLength": 1
            },
            "timeout_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300000
            }
          },
          "required": [
            "tool",
            "timeout_ms"
          ],
          "additionalProperties": false,
          "x-rho-atomic": true
        },
        "stop": {
          "type": "object",
          "properties": {
            "tool": {
              "type": "string",
              "minLength": 1
            },
            "timeout_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300000
            },
            "max_continuations": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            }
          },
          "required": [
            "tool",
            "timeout_ms",
            "max_continuations"
          ],
          "additionalProperties": false,
          "x-rho-atomic": true
        }
      },
      "additionalProperties": false
    },
    "default_enabled": true,
