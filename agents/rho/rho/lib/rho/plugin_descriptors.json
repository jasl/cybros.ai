  {
    "id": "rho.lifecycle_hooks",
    "display_name": "Lifecycle Hooks",
    "category": "conversation",
    "description": "Run configured tools at conversation and turn lifecycle events.",
    "configuration_version": 1,
    "configuration_schema": {
      "type": "object",
      "properties": {
        "turn_start": {
          "type": "object",
          "properties": {
            "tool": {
              "type": "string",
              "minLength": 1
            },
            "timeout_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300000
            }
          },
          "required": [
            "tool",
            "timeout_ms"
          ],
          "additionalProperties": false,
          "x-rho-atomic": true
        },
        "pre_compact": {
          "type": "object",
          "properties": {
            "tool": {
              "type": "string",
              "minLength": 1
            },
            "timeout_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300000
            }
          },
          "required": [
            "tool",
            "timeout_ms"
          ],
          "additionalProperties": false,
          "x-rho-atomic": true
        },
        "post_compact": {
          "type": "object",
          "properties": {
            "tool": {
              "type": "string",
              "minLength": 1
            },
            "timeout_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300000
            }
          },
          "required": [
            "tool",
            "timeout_ms"
          ],
          "additionalProperties": false,
          "x-rho-atomic": true
        },
        "stop": {
          "type": "object",
          "properties": {
            "tool": {
              "type": "string",
              "minLength": 1
            },
            "timeout_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300000
            },
            "max_continuations": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            }
          },
          "required": [
            "tool",
            "timeout_ms",
            "max_continuations"
          ],
          "additionalProperties": false,
          "x-rho-atomic": true
        }
      },
      "additionalProperties": false
    },
    "default_enabled": true,
    "modes": [
      "full",
      "agent"
    ],
    "requires": [],
    "restart_only": false
  },
  {
    "id": "rho.memory_review",
    "display_name": "Memory review",
    "category": "conversation",
    "description": "Review reusable knowledge from completed work",
    "configuration_version": 1,
    "configuration_schema": {
      "type": "object",
      "properties": {
        "auto_enable": {
          "type": "boolean",
          "default": false,
          "title": "Review every conversation",
          "description": "Turn memory review on for each conversation at its first completed reply, unless that conversation switched it off. One extra model call per reply."
        },
        "path": {
          "type": "string",
          "default": "speaker/review.md",
          "title": "Memory document",
          "description": "The scoped document reviews keep, for example speaker/review.md; it needs a writable root in the conversation."
        },
        "model": {
          "type": [
            "string",
            "null"
          ],
          "title": "Review model",
          "description": "Writes the review; unset uses each completed reply's model.",
          "x-rho-choices": {
            "source": "models",
            "workload": "text_generation"
          }
        }
      },
      "additionalProperties": false
    },
    "default_enabled": true,
    "modes": [
      "full",
      "agent"
    ],
    "requires": [],
    "restart_only": false
  },
