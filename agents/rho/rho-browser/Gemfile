source "https://rubygems.org"

# Specify this gem's dependencies in rho-browser.gemspec.
gemspec

# The SDK and the runner ride alongside in this monorepo; released versions
# come from rubygems once the gems cut releases.
gem "cybros_agent", path: "../../../sdks/ruby"
gem "rho-runner", path: "../rho-runner"

# The development group: a checkout's suite, never an installed prefix's
# (the installer runs `--without development test`).
group :development do
  gem "rake", "~> 13.0"

  gem "minitest", "~> 6.0"

  gem "rbs", require: false
  gem "rubocop", "~> 1.21", require: false
  gem "rubocop-rails-omakase", require: false
end
