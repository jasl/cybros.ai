                    "effect_scope": {
                      "type": "string",
                      "enum": [
                        "closed",
                        "open"
                      ]
                    },
                    "idempotency": {
                      "type": "string",
                      "enum": [
                        "intrinsic",
                        "keyed",
                        "none"
                      ]
                    },
                    "reconciliation": {
                      "type": "string",
                      "enum": [
                        "none",
                        "lookup"
                      ]
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "destructive",
                    "effect_scope",
                    "idempotency",
                    "reconciliation"
