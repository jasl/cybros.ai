            "timeout_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 604800000
            },
            "startup_timeout_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 604800000,
              "default": 30000
            },
            "serves": {
              "type": "string",
              "enum": [
                "agent",
                "runner"
              ]
            },
