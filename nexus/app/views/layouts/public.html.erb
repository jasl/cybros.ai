<!DOCTYPE html>
<html lang="<%= I18n.locale %>"<% if explicit_theme %> data-theme="<%= explicit_theme %>"<% end %>>
  <%= render "layouts/shared/head", turbo_cache: !@capability_page_response %>

  <body class="bg-base-100">
    <a href="#main" class="btn btn-sm btn-primary fixed start-4 top-4 z-50 -translate-y-20 focus:translate-y-0" data-turbo="false"><%= t("layouts.public.skip_to_main") %></a>

    <div class="relative flex min-h-dvh flex-col">
      <header class="absolute start-6 top-5">
        <span class="text-lg font-semibold tracking-tight"><%= t("brand.name") %></span>
      </header>

      <div class="mx-auto flex w-full max-w-sm grow flex-col justify-center gap-6 px-4 py-20">
        <main id="main" class="w-full">
          <%= yield %>
        </main>
      </div>
    </div>
  </body>
</html>
