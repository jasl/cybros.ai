<% content_for :title, "Settings" %>

<%= render layout: "settings/shell", locals: { current: :tokens } do %>
  <div class="space-y-8">
    <section class="space-y-4">
      <div>
        <h2 class="text-xs font-medium text-base-content/60">New token</h2>
        <p class="mt-1 text-sm text-base-content/60">
          Personal access tokens authenticate automation acting as you. The token is shown exactly once.
        </p>
      </div>

      <%# Classic full-page POST: the reveal is a non-redirect create response,
    which Turbo form submission rejects — and keeping the secret out of
    Turbo's snapshot pipeline prevents it from appearing in a cached page. %>
      <%= form_with url: settings_tokens_path, scope: :token, data: { turbo: false } do |form| %>
        <div class="rounded-box border border-base-300 bg-base-200">
          <%= render layout: "shared/form_row", locals: { form:, attribute: :name, label: "Name" } do %>
            <%= validated_field form, :text_field, :name, Array(@invalid_token&.errors&.full_messages_for(:name)), size: :sm, value: @token_form.fetch(:name), required: true, maxlength: AccessToken::NAME_MAX_LENGTH %>
          <% end %>
          <%= render layout: "shared/form_row", locals: { form:, attribute: :note, label: "Note (optional)" } do %>
            <%= validated_field form, :text_field, :note, Array(@invalid_token&.errors&.full_messages_for(:note)), size: :sm, value: @token_form.fetch(:note), maxlength: AccessToken::NOTE_MAX_LENGTH %>
          <% end %>
          <%= render layout: "shared/form_row", locals: { form:, attribute: :current_password, label: "Current password" } do %>
            <%= validated_field form, :password_field, :current_password, @current_password_errors, size: :sm, required: true, autocomplete: "current-password", maxlength: 72 %>
          <% end %>
          <% plane_errors = Array(@invalid_token&.errors&.full_messages_for(:credential_plane)) %>
          <% plane_errors_id = form.field_id(:credential_plane, :errors) %>
          <%= tag.fieldset(
            class: "grid min-w-0 gap-3 px-4 py-4 sm:grid-cols-2 sm:items-center sm:gap-6",
            aria: { invalid: plane_errors.any?.to_s, describedby: (plane_errors_id if plane_errors.any?) }
          ) do %>
            <legend class="sr-only">Token kind</legend>
            <div class="min-w-0">
              <p class="text-sm" aria-hidden="true">Token kind</p>
              <p class="text-xs text-base-content/60">A member token automates your own account<%= "; a platform token reaches installation administration" if Current.user.admin? %>.</p>
              <%= validator_hints(plane_errors, id: plane_errors_id) %>
            </div>
            <div class="flex flex-wrap justify-start gap-4 sm:justify-end">
              <% planes = Current.user.admin? ? %w[member platform] : %w[member] %>
              <% planes.each do |plane| %>
                <label class="label cursor-pointer gap-2 py-0 text-sm">
                  <%= radio_button_tag "token[credential_plane]", plane, @token_form.fetch(:credential_plane) == plane, id: "token_plane_#{plane}", class: "radio radio-sm" %>
                  <%= plane %>
                </label>
              <% end %>
            </div>
          <% end %>
        </div>
        <div class="mt-3 flex justify-end">
          <%= form.submit "Create token", class: "btn btn-primary btn-sm" %>
        </div>
      <% end %>
    </section>

    <section class="space-y-4">
      <div>
        <h2 class="text-xs font-medium text-base-content/60">Your tokens</h2>
      </div>

      <% if @tokens.any? %>
        <div class="overflow-x-auto rounded-box border border-base-300 bg-base-200">
          <table class="table">
            <thead>
              <tr>
                <th>Name</th>
                <th>Kind</th>
                <th>Created</th>
                <th>Last used</th>
                <th class="text-end">Action</th>
              </tr>
            </thead>
            <tbody>
              <% @tokens.each do |token| %>
                <% token_target = "#{token.name} (Token ID #{token.lookup_id})" %>
                <tr data-token-id="<%= token.public_id %>">
                  <td>
                    <span class="block font-medium"><%= token.name %></span>
                    <span class="mt-1 block text-xs text-base-content/60">Token ID <code class="break-all font-mono"><%= token.lookup_id %></code></span>
                  </td>
                  <td>
                    <span class="badge badge-ghost badge-sm"><%= token.credential_plane %></span>
                  </td>
                  <td class="text-base-content/60" title="<%= token.created_at.iso8601 %>"><%= time_ago_in_words(token.created_at) %> ago</td>
                  <td class="text-base-content/60">
                    <%= token.last_used_at ? "#{time_ago_in_words(token.last_used_at)} ago" : "Never" %>
                  </td>
                  <td class="text-end">
                    <% if token.revoked? %>
                      <span class="badge badge-ghost badge-sm">Revoked</span>
                    <% else %>
                      <%= button_to "Revoke", settings_token_revocation_path(token), method: :post, class: "btn btn-ghost btn-sm", aria: { label: "Revoke #{token_target}" }, data: { turbo_confirm: "Revoke #{token_target}? Automation using it stops authenticating immediately." } %>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <%= render "shared/pagination_footer", pagy: @tokens_pagy, noun: "tokens", aria_label: "Token pages" %>
      <% else %>
        <p class="text-sm text-base-content/60">No tokens yet.</p>
      <% end %>
    </section>
  </div>
<% end %>
