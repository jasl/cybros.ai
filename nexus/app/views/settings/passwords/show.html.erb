<% content_for :title, "Settings" %>

<%= render layout: "settings/shell", locals: { current: :password } do %>
  <% if @identity.errors.any? %>
    <div role="alert" class="alert alert-error alert-soft">
      <span class="iconify lucide--circle-alert size-5" aria-hidden="true"></span>
      <span>The password could not be changed — check the highlighted fields.</span>
    </div>
  <% end %>

  <section>
    <h2 class="mb-1 text-xs font-medium text-base-content/60">Password</h2>
    <p class="mb-3 text-sm text-base-content/60">
      Use at least <%= Identity::PASSWORD_MIN_LENGTH %> characters. Changing your password signs out every other device.
    </p>
    <%= validator_hints(@identity.errors.full_messages_for(:base), id: "password-base-errors") %>
    <%= form_with url: settings_password_path, method: :patch, scope: :password, data: { turbo_frame: "_top" } do |form| %>
      <%= hidden_field_tag :return_to, params[:return_to] if params[:return_to].present? %>
      <div class="rounded-box border border-base-300 bg-base-200">
        <%= render layout: "shared/form_row", locals: { form:, attribute: :current_password, label: "Current password" } do %>
          <%= validated_field form, :password_field, :current_password, @identity.errors.full_messages_for(:current_password), size: :sm, required: true, autocomplete: "current-password", maxlength: 72 %>
        <% end %>
        <%= render layout: "shared/form_row", locals: { form:, attribute: :password, label: "New password" } do %>
          <%= validated_field form, :password_field, :password, @identity.errors.full_messages_for(:password), size: :sm, required: true, autocomplete: "new-password", maxlength: 72 %>
        <% end %>
        <%= render layout: "shared/form_row", locals: { form:, attribute: :password_confirmation, label: "Repeat new password" } do %>
          <%= validated_field form, :password_field, :password_confirmation, @identity.errors.full_messages_for(:password_confirmation), size: :sm, required: true, autocomplete: "new-password", maxlength: 72 %>
        <% end %>
      </div>
      <div class="mt-3 flex justify-end">
        <%= form.submit "Change password", class: "btn btn-primary btn-sm" %>
      </div>
    <% end %>
  </section>
<% end %>
