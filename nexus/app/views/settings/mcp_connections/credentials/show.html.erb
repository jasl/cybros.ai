<% content_for :title, t("mcp_connections.manage_credential") %>
<%= render layout: "settings/shell", locals: { current: :mcp_connections } do %>
  <section class="space-y-4">
    <%= link_to @connection.name, settings_mcp_connection_path(@connection), class: "link break-words" %>
    <h2 class="text-lg font-medium"><%= t("mcp_connections.manage_credential") %></h2>
    <p class="text-sm text-base-content/70"><%= t("mcp_connections.rotation_hint") %></p>
    <%= form_with url: settings_mcp_connection_credential_path(@connection), scope: :credential, method: :put, class: "space-y-4" do |form| %>
      <%= render "settings/mcp_connections/errors", connection: @connection %>
      <%= form.hidden_field :lock_version, value: @connection.lock_version %>
      <div><%= form.label :bearer_token, t("mcp_connections.bearer_token"), class: "label" %><%= form.password_field :bearer_token, required: true, autocomplete: "new-password", class: "input w-full" %></div>
      <%= form.submit t("mcp_connections.rotate"), class: "btn btn-primary" %>
    <% end %>
    <p class="text-sm text-base-content/70"><%= t("mcp_connections.clear_hint") %></p>
    <%= button_to t("mcp_connections.clear"), settings_mcp_connection_credential_path(@connection), method: :delete, params: { command: { lock_version: @connection.lock_version } }, class: "btn btn-error btn-outline" %>
  </section>
<% end %>
