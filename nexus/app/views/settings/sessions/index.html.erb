<% content_for :title, t("settings.sessions.index.settings") %>

<%= render layout: "settings/shell", locals: { current: :sessions } do %>
  <section class="space-y-4">
    <div>
      <h2 class="text-xs font-medium text-base-content/60"><%= t("settings.sessions.index.active_sessions") %></h2>
      <p class="mt-1 text-sm text-base-content/60"><%= t("settings.sessions.index.review_browser_and_api_sessions_signed_in_to_your") %></p>
    </div>

    <div class="overflow-x-auto rounded-box border border-base-300 bg-base-200">
      <table class="table">
        <thead>
          <tr>
            <th><%= t("settings.sessions.index.device") %></th>
            <th><%= t("settings.sessions.index.signed_in") %></th>
            <th class="text-end"><%= t("settings.sessions.index.action") %></th>
          </tr>
        </thead>
        <tbody>
          <% @sessions.each do |session_record| %>
            <% session_target = session_record.api? ? t("settings.sessions.index.api_session_session_id", session_id: (session_record.public_id)) : session_record.device_description %>
            <tr data-session-id="<%= session_record.public_id %>">
              <td>
                <span class="font-medium"><%= session_record.device_description %></span>
                <% if session_record.api? %>
                  <span class="mt-1 block text-xs font-normal text-base-content/60"><%= t("settings.sessions.index.session_id") %> <code class="break-all font-mono"><%= session_record.public_id %></code></span>
                <% end %>
                <% if session_record == Current.session %>
                  <span class="badge badge-ghost badge-sm ms-1 whitespace-nowrap"><%= t("settings.sessions.index.this_device") %></span>
                <% end %>
              </td>
              <td class="text-base-content/60" title="<%= session_record.created_at.iso8601 %>">
                <%= t("settings.sessions.index.elapsed_ago", elapsed: (time_ago_in_words(session_record.created_at))) %>
              </td>
              <td class="text-end">
                <% if session_record == Current.session %>
                  <%= button_to t("settings.sessions.index.log_out"), session_path, method: :delete, class: "btn btn-ghost btn-sm whitespace-nowrap", form: { data: { turbo_frame: "_top" } } %>
                <% else %>
                  <%= button_to t("settings.sessions.index.revoke"), settings_session_path(session_record), method: :delete, class: "btn btn-ghost btn-sm", aria: { label: t("settings.sessions.index.revoke_session", session: (session_target)) }, data: { turbo_confirm: t("settings.sessions.index.revoke_session_clients_using_this_session_lose_access_immediately", session: (session_target)) }, form: { data: { turbo_frame: "_top" } } %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <%= render "shared/pagination_footer", pagy: @sessions_pagy, noun: "sessions", aria_label: t("settings.sessions.index.active_sessions_pages") %>
  </section>
<% end %>
