<% content_for :title, t("admin.agents.stewards.show.reassign_steward") %>

<div class="space-y-8">
  <header class="space-y-4">
    <%= render "shared/back_navigation", path: admin_agent_path(@member), label: member_display_name(@member) %>
    <div class="space-y-1">
      <h1 class="text-xl font-medium tracking-tight"><%= t("admin.agents.stewards.show.reassign_steward") %></h1>
      <p class="text-sm text-base-content/60">
        <%= t("admin.agents.stewards.show.choose_the_active_human_member_responsible_for_member", member: (member_display_name(@member))) %>
      </p>
    </div>
  </header>

  <% if @member.removed? %>
    <div role="alert" class="alert alert-warning">
      <span>
        <%= t("admin.agents.stewards.show.reassignment_keeps_the_agent_removed_and_its_old_credentials") %>
      </span>
    </div>
  <% end %>

  <section>
    <%= render "shared/member_search_form",
      search_url: admin_agent_steward_path(@member),
      title: t("admin.agents.stewards.show.find_manager"),
      search_label: t("admin.users.index.search"),
      query: @query,
      max_length: Admin::Agents::StewardsController::SEARCH_QUERY_MAX_LENGTH %>
  </section>

  <section class="rounded-box border border-base-300 bg-base-200">
    <% if @steward_candidates.any? %>
      <ul class="list">
        <% @steward_candidates.each do |candidate| %>
          <li class="list-row items-center"
            data-steward-candidate-id="<%= candidate.public_id %>">
            <div class="list-col-grow min-w-0">
              <p class="font-medium wrap-anywhere"><%= candidate.display_name %></p>
              <p class="text-sm text-base-content/60 hyphens-none wrap-anywhere"><%= candidate.email %></p>
            </div>
            <div class="list-col-wrap justify-self-start sm:justify-self-end sm:[grid-row-start:1]">
              <% if candidate == @member.steward %>
                <span class="badge badge-ghost badge-sm"><%= t("admin.agents.stewards.show.current_steward") %></span>
              <% else %>
                <%= button_to t("admin.agents.stewards.show.assign"),
                  admin_agent_steward_path(@member),
                  method: :patch,
                  params: { steward: { steward_public_id: candidate.public_id } },
                  class: "btn btn-sm btn-primary",
                  aria: { label: t("admin.agents.stewards.show.assign_member_as_steward", member: (candidate.display_name)) } %>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="px-4 py-10 text-center">
        <p class="text-sm font-medium"><%= t("admin.agents.stewards.show.no_matching_members") %></p>
        <p class="mt-1 text-sm text-base-content/60"><%= t("admin.agents.stewards.show.try_a_different_name_or_email_address") %></p>
      </div>
    <% end %>
  </section>

  <%= render "shared/pagination_footer", pagy: @stewards_pagy, noun: "eligible_users", aria_label: t("admin.agents.stewards.show.steward_candidates_pages") %>
</div>
