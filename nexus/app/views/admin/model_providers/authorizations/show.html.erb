<% content_for :title, "#{model_provider_name(@provider.fetch(:id))} subscription" %>

<div class="space-y-8">
  <%= render "admin/model_providers/header", provider: @provider, title: "Subscription sign-in", current: :credentials, description: "Connect a subscription for agents to use through Nexus." %>
  <%= render "admin/model_providers/authorization", provider: @provider, authorization: @authorization, authorization_session: @authorization[:session] %>
</div>
