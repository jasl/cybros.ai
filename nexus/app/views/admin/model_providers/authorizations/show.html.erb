<% content_for :title, t("admin.model_providers.authorizations.show.provider_subscription", provider: (model_provider_name(@provider.fetch(:id)))) %>

<div class="space-y-8">
  <%= render "admin/model_providers/header", provider: @provider, title: t("admin.model_providers.authorizations.show.subscription_sign_in"), current: :credentials, description: t("admin.model_providers.authorizations.show.connect_a_subscription_for_agents_to_use_through_brand", brand: t("brand.name")) %>
  <%= render "admin/model_providers/authorization", provider: @provider, authorization: @authorization, authorization_session: @authorization[:session] %>
</div>
