<% content_for :title, t("admin.model_providers.model_definitions.show.edit_model") %>
<div class="space-y-8">
  <%= render "admin/model_providers/header", provider: @provider, title: t("admin.model_providers.model_definitions.show.edit_model"), current: :model, description: t("admin.model_providers.model_definitions.show.edit_this_model_s_context_capabilities_and_optional_cost") %>
  <p class="text-sm font-medium wrap-anywhere"><%= @model.fetch(:model) %></p>
  <% if @model.fetch(:removed) %><p class="text-sm text-base-content/60"><%= t("admin.model_providers.model_definitions.show.this_model_is_removed_saving_a_definition_makes_it") %></p><% end %>
  <%= render "form", form: @form, provider: @provider, creating: false %>
  <section class="flex flex-wrap gap-3 border-t border-base-300 pt-5" aria-label="<%= t("admin.model_providers.model_definitions.show.model_actions") %>">
    <% if @installation_model && @model.fetch(:source) != "catalog" %>
      <%= button_to t("admin.model_providers.model_definitions.show.restore_installation_model"), admin_model_provider_model_reset_path(@provider.fetch(:id)),
        params: { model_reset: { model: @model.fetch(:model), expected_lock_version: @provider.fetch(:lock_version) } },
        class: "btn btn-sm btn-outline", form: { data: { turbo_confirm: t("admin.model_providers.model_definitions.show.discard_this_model_s_edits_and_restore_its_installation") } } %>
    <% end %>
    <% unless @model.fetch(:removed) %>
      <%= button_to t("admin.model_providers.model_definitions.show.remove_model"), admin_model_provider_model_definition_path(@provider.fetch(:id)), method: :delete,
        params: { model_definition: { model: @model.fetch(:model), expected_lock_version: @provider.fetch(:lock_version) } },
        class: "btn btn-sm btn-outline", form: { data: { turbo_confirm: t("admin.model_providers.model_definitions.show.remove_this_model_new_requests_will_stop_custom_model") } } %>
    <% end %>
  </section>
</div>
