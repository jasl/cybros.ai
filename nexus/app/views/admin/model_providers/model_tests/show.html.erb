<% content_for :title, "Test model connection" %>
<div class="space-y-8">
  <%= render "admin/model_providers/header", provider: @provider, title: "Test model connection", current: :test, description: "Test a model using the saved provider connection." %>
  <%= turbo_frame_tag "model-connection-test" do %>
  <section class="space-y-4" aria-label="Model connection test">
    <p class="text-sm font-medium wrap-anywhere"><%= @model.fetch(:ref) %></p>
    <p class="max-w-prose text-sm leading-relaxed text-base-content/60">This sends one small request for this model's workload and may incur provider charges. It can take up to 30 seconds. It checks the connection, not all model capabilities. Test usage is not included in agent usage statistics.</p>
    <p class="max-w-prose text-sm leading-relaxed text-base-content/60">A definite model-not-found response marks this model invalid and hides it from agents. A successful test clears that mark and preserves any manual hiding. Authentication errors, timeouts and other failures do not change model availability.</p>
    <%= form_with url: admin_model_provider_model_test_path(@provider.fetch(:id)), scope: :model_test do |form| %>
      <%= form.hidden_field :model, value: @model.fetch(:ref) %>
      <%= form.hidden_field :expected_lock_version, value: @provider.fetch(:lock_version) %>
      <%= form.submit "Run connection test", class: "btn btn-primary btn-sm", data: { turbo_submits_with: "Testing…" } %>
    <% end %>
    <% if @rate_limited %>
      <p class="text-sm text-error" role="alert"><%= t("admin.model_providers.test_rate_limited") %></p>
    <% end %>
    <% if @test_result %>
      <div class="rounded-box border border-base-300 bg-base-200 p-4 space-y-2 text-sm" role="status">
        <p><%= model_connection_test_message(@test_result.outcome) %></p>
        <p class="text-base-content/60"><%= @test_result.duration_ms %> ms<% if @test_result.http_status %> · HTTP <%= @test_result.http_status %><% end %></p>
        <% if @test_result.availability_update == :stale %>
          <p>Settings changed during this test. The result was not applied; review the current model settings before testing again.</p>
        <% elsif %i[invalid not_found].include?(@test_result.availability_update) %>
          <p>The test finished, but its availability change could not be saved. Review the model settings.</p>
        <% elsif @test_result.outcome == :model_not_found %>
          <p>This model is now marked invalid and hidden from agents. Its definition and pricing are kept.</p>
        <% end %>
      </div>
    <% end %>
  </section>
  <% end %>
</div>
