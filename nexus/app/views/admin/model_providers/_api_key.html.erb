<section aria-label="<%= t("admin.model_providers.api_key.api_key") %>" class="space-y-5 rounded-box border border-base-300 bg-base-200 p-5 sm:p-6">
  <div class="flex items-start gap-3">
    <span class="iconify <%= provider.fetch(:configured) ? "lucide--circle-check text-success" : "lucide--key-round text-base-content/60" %> mt-0.5 size-5 shrink-0" aria-hidden="true"></span>
    <div class="min-w-0 space-y-2">
      <h2 class="font-medium" role="status"><%= provider_credential_label(provider) %></h2>
      <p class="text-sm leading-relaxed text-base-content/60"><%= t("admin.model_providers.api_key.encrypted_in_brand_and_never_sent_to_agents_saving", brand: t("brand.name")) %></p>
    </div>
  </div>
  <%= form_with url: admin_model_provider_api_key_path(provider.fetch(:id)), method: :patch, scope: :credential, id: "provider-api-key-form", class: "space-y-2" do |form| %>
    <%= form.label :api_key, t("admin.model_providers.api_key.api_key"), class: "sr-only" %>
    <%= form.password_field :api_key, required: true, autocomplete: "new-password", spellcheck: false, class: "input input-sm w-full", placeholder: t("admin.model_providers.api_key.enter_api_key"), aria: { describedby: "provider-api-key-help" } %>
    <p id="provider-api-key-help" class="text-sm text-base-content/60"><%= provider.fetch(:configured) ? t("admin.model_providers.api_key.enter_a_new_key_to_update_this_connection") : t("admin.model_providers.api_key.paste_the_key_from_your_provider_account") %></p>
  <% end %>
  <div class="flex flex-wrap items-center gap-3">
    <%= button_tag(provider.fetch(:configured) ? t("admin.model_providers.api_key.update") : t("admin.model_providers.api_key.save"), type: :submit, form: "provider-api-key-form", class: "btn btn-primary btn-sm") %>
    <% if provider.fetch(:configured) %>
      <%= button_to t("admin.model_providers.api_key.remove"), admin_model_provider_api_key_path(provider.fetch(:id)), method: :delete, class: "btn btn-sm btn-outline btn-error", data: { turbo_confirm: t("admin.model_providers.api_key.remove_the_api_key_for_provider_new_requests_will", provider: (model_provider_name(provider.fetch(:id)))) } %>
    <% end %>
  </div>
</section>
