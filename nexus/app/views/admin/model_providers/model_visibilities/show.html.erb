<% content_for :title, "#{model_provider_name(@provider.fetch(:id))} models" %>

<div class="space-y-8">
  <%= render "admin/model_providers/header", provider: @provider, title: "Model visibility", current: :models, description: "Choose which models are visible to every agent in this installation." %>
  <p class="max-w-prose text-sm leading-relaxed text-base-content/60">Hidden models cannot be selected for new requests. Existing work can finish, and definitions and pricing are kept. Each agent selects its own default model.</p>
  <%= render "admin/model_providers/models", provider: @provider, models: @models, editable: true, unavailable_models: @unavailable_models %>
</div>
