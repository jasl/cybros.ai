<% content_for :title, "#{model_provider_name(@provider.fetch(:id))} models" %>

<div class="space-y-6">
  <%= render "admin/model_providers/header", provider: @provider, current: :models, description: "Choose which models are visible to every agent in this installation." %>
  <p class="max-w-prose text-sm leading-relaxed text-base-content/60">Hidden models cannot be selected for new requests. Existing work can finish, and definitions and pricing are kept. Each agent selects its own default model.</p>
  <% if @provider.fetch(:lock_version).nil? %>
    <p class="rounded-box border border-base-300 bg-base-200 p-4 text-sm text-base-content/70"><%= link_to "Enable this provider", admin_model_provider_lane_path(@provider.fetch(:id)), class: "link" %> to begin configuring its models. You can disable it again later without losing your settings.</p>
  <% end %>
  <%= render "admin/model_providers/models", provider: @provider, models: @models, editable: true %>
</div>
