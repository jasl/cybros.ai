<% content_for :title, t("admin.model_providers.model_discoveries.show.discover_models") %>
<div class="space-y-8">
  <%= render "admin/model_providers/header", provider: @provider, title: t("admin.model_providers.model_discoveries.show.discover_model_ids"), current: :discovery, description: t("admin.model_providers.model_discoveries.show.read_the_model_directory_from_your_saved_endpoint") %>
  <%= turbo_frame_tag "model-directory" do %>
  <section class="space-y-4" aria-label="<%= t("admin.model_providers.model_discoveries.show.model_discovery") %>">
    <p class="max-w-prose text-sm text-base-content/60"><%= t("admin.model_providers.model_discoveries.show.a_complete_successful_fetch_marks_configured_models_missing_from") %></p>
    <p class="max-w-prose text-sm text-base-content/60"><%= t("admin.model_providers.model_discoveries.show.some_providers_do_not_offer_a_directory_a_failed") %></p>
    <div class="flex flex-wrap gap-2">
      <%= button_to t("admin.model_providers.model_discoveries.show.fetch_model_ids"), admin_model_provider_model_discovery_path(@provider.fetch(:id)), params: { model_discovery: { expected_lock_version: @provider.fetch(:lock_version) } }, class: "btn btn-primary btn-sm", data: { turbo_submits_with: t("admin.model_providers.model_discoveries.show.fetching") } %>
      <%= link_to t("admin.model_providers.model_discoveries.show.enter_a_model_id_manually"), new_admin_model_provider_model_definition_path(@provider.fetch(:id)), class: "btn btn-ghost btn-sm", data: { turbo_frame: "_top" } %>
    </div>
    <% if @discovery %>
      <% if @discovery.success? %>
        <p class="text-sm" role="status"><%= t("admin.model_providers.model_discoveries.show.model_directory_synced_review_availability_on_the_provider_page") %></p>
        <% if @discovery.models.empty? %>
          <p class="text-sm text-base-content/60"><%= t("admin.model_providers.model_discoveries.show.this_endpoint_returned_an_empty_directory_all_configured_models") %></p>
        <% else %>
          <ul class="divide-y divide-base-300 rounded-box border border-base-300 bg-base-200">
            <% @discovery.models.each do |model| %>
              <% configured_models = @models_by_id.fetch(model.fetch(:id), []) %>
              <% occupied_model = @models_by_ref["#{@provider.fetch(:id)}/#{model.fetch(:id)}"] %>
              <li class="flex flex-wrap items-center justify-between gap-3 p-4" data-model-id="<%= model.fetch(:id) %>">
                <div class="min-w-0 flex-1 basis-full sm:basis-0"><p class="text-sm font-medium wrap-anywhere"><%= model.fetch(:id) %></p><% if model[:display_name].present? %><p class="text-xs text-base-content/60 wrap-anywhere"><%= model[:display_name] %></p><% end %></div>
                <% if configured_models.any? %>
                  <div class="flex flex-col items-end gap-2 min-w-0 max-w-full ml-auto">
                    <% configured_models.each do |configured| %>
                      <div class="flex flex-wrap items-center justify-end gap-2 max-w-full">
                        <% if configured.fetch(:model) != "#{@provider.fetch(:id)}/#{model.fetch(:id)}" || configured_models.many? %>
                          <span class="text-xs text-base-content/60 wrap-anywhere"><%= configured.fetch(:model) %></span>
                        <% end %>
                        <span class="badge badge-sm badge-ghost"><%= configured.fetch(:removed) ? t("admin.model_providers.model_discoveries.show.removed") : t("admin.model_providers.model_discoveries.show.added") %></span>
                        <%= link_to configured.fetch(:removed) ? t("admin.model_providers.model_discoveries.show.review_model") : t("admin.model_providers.model_discoveries.show.edit_model"), admin_model_provider_model_definition_path(@provider.fetch(:id), model: configured.fetch(:model)), class: "btn btn-ghost btn-sm", data: { turbo_frame: "_top" }, aria: { label: t(configured.fetch(:removed) ? "admin.model_providers.model_discoveries.show.review_model_label" : "admin.model_providers.model_discoveries.show.edit_model_label", model: configured.fetch(:model)) } %>
                      </div>
                    <% end %>
                  </div>
                <% elsif occupied_model %>
                  <span class="badge badge-sm badge-ghost"><%= t("admin.model_providers.model_discoveries.show.model_id_in_use") %></span>
                  <%= link_to t("admin.model_providers.model_discoveries.show.edit_model"), admin_model_provider_model_definition_path(@provider.fetch(:id), model: occupied_model.fetch(:model)), class: "btn btn-ghost btn-sm ml-auto", data: { turbo_frame: "_top" }, aria: { label: t("admin.model_providers.model_discoveries.show.edit_model_label", model: (occupied_model.fetch(:model))) } %>
                <% else %>
                  <%= link_to t("admin.model_providers.model_discoveries.show.add_model"), new_admin_model_provider_model_definition_path(@provider.fetch(:id), model_id: model.fetch(:id), display_name: model[:display_name]), class: "btn btn-sm ml-auto", data: { turbo_frame: "_top" }, aria: { label: t("admin.model_providers.model_discoveries.show.add_model_label", model: (model.fetch(:id))) } %>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% end %>
      <% else %>
        <div class="rounded-box border border-base-300 bg-base-200 p-4 text-sm" role="alert"><%= t("admin.model_providers.model_discoveries.show.error_your_existing_models_are_unchanged", error: (model_discovery_message(@discovery.outcome))) %></div>
      <% end %>
    <% end %>
  </section>
  <% end %>
</div>
