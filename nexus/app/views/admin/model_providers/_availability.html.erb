<section id="provider-availability" class="flex flex-wrap items-center justify-between gap-4 rounded-box border border-base-300 bg-base-200 p-5">
  <div class="min-w-0 max-w-prose space-y-1">
    <h2 class="text-sm font-medium">Provider availability</h2>
    <p class="text-sm leading-relaxed text-base-content/60">Allow new requests from agents. Disabling keeps credentials and model settings.</p>
  </div>
  <div class="inline-flex shrink-0 items-center gap-1 rounded-full border border-base-300 bg-base-100 p-1" role="group" aria-label="Provider availability">
    <% [[true, "Enabled", "Enable provider"], [false, "Disabled", "Disable provider"]].each do |enabled, label, name| %>
      <% selected = provider.fetch(:enabled) == enabled %>
      <%= button_to label, admin_model_provider_lane_path(provider.fetch(:id)), method: :patch,
        params: { lane: { enabled: enabled, expected_lock_version: provider.fetch(:lock_version) } },
        class: provider_choice_classes(selected: selected), disabled: selected,
        aria: { label: name, pressed: selected } %>
    <% end %>
  </div>
</section>
