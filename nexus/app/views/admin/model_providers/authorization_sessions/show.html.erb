<% content_for :title, t("admin.model_providers.authorization_sessions.show.provider_sign_in", provider: (model_provider_name(@provider.fetch(:id)))) %>

<div class="space-y-8">
  <%= render "admin/model_providers/header", provider: @provider, title: t("admin.model_providers.authorization_sessions.show.subscription_sign_in"), current: :credentials, description: t("admin.model_providers.authorization_sessions.show.finish_signing_in_with_your_provider_account") %>
  <%= render "admin/model_providers/authorization", provider: @provider, authorization: @authorization, authorization_session: @authorization_session,
    refresh_provider: turbo_frame_request? && @authorization.fetch(:state) == "authorized" && latest_provider_sign_in_completed?(@authorization, @authorization_session) %>
</div>
