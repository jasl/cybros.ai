<% content_for :title, model_provider_name(@provider.fetch(:id), display_name: @provider[:display_name]) %>
<% content_for :head do %>
  <meta name="turbo-refresh-scroll" content="preserve">
<% end %>

<div class="space-y-8">
  <%= render "admin/model_providers/header", provider: @provider, current: :overview, description: "Manage access and models for this provider." %>
  <div class="flex flex-wrap gap-2">
    <%= link_to "Edit connection", admin_model_provider_definition_path(@provider.fetch(:id)), class: "btn btn-sm" %>
  </div>
  <%= render "admin/model_providers/availability", provider: @provider %>

  <% if @provider.fetch(:credentials) == "oauth_tokens" %>
    <%= render "admin/model_providers/authorization", provider: @provider, authorization: @authorization, authorization_session: @authorization[:session], show_models_link: false %>
  <% elsif @provider.fetch(:credentials) == "api_key" %>
    <%= render "admin/model_providers/api_key", provider: @provider %>
  <% else %>
    <p class="text-sm text-base-content/60">This provider does not need credentials.</p>
  <% end %>

  <% if @provider.fetch(:unavailable_until) %>
    <p class="text-sm text-base-content/70">The provider has asked Nexus to wait until <%= @provider.fetch(:unavailable_until).to_fs(:long) %> before starting more requests.</p>
  <% end %>

  <section id="provider-models" class="space-y-3" aria-label="Provider models">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h2 class="text-sm font-medium">Models <span class="ml-1 text-base-content/50"><%= @models.length %></span></h2>
      <div class="flex flex-wrap gap-2">
        <%= link_to "Discover model IDs", admin_model_provider_model_discovery_path(@provider.fetch(:id)), class: "btn btn-sm" %>
        <%= link_to "Add model", new_admin_model_provider_model_definition_path(@provider.fetch(:id)), class: "btn btn-primary btn-sm" %>
      </div>
    </div>
    <%= render "admin/model_providers/models", provider: @provider, models: @models, editable: true, unavailable_models: @unavailable_models, model_names: @model_names %>
    <% removed_models = @configuration.fetch(:models).select { |model| model.fetch(:removed) } %>
    <% if removed_models.any? %>
      <details class="rounded-box border border-base-300 p-4">
        <summary class="cursor-pointer text-sm">Removed models (<%= removed_models.length %>)</summary>
        <ul class="mt-3 space-y-3 text-sm">
          <% removed_models.each do |model| %>
            <li class="flex flex-wrap items-center justify-between gap-2">
              <span class="min-w-0 flex-1 wrap-anywhere"><%= model.fetch(:model) %></span>
              <%= link_to "Configure again", admin_model_provider_model_definition_path(@provider.fetch(:id), model: model.fetch(:model)), class: "link", aria: { label: "Configure #{model.fetch(:model)} again" } %>
            </li>
          <% end %>
        </ul>
      </details>
    <% end %>
  </section>
</div>
