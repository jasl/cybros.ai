<% content_for :title, "Add provider" %>
<div class="space-y-6">
  <header class="space-y-2">
    <%= link_to "Model providers", admin_model_providers_path, class: "link text-sm" %>
    <h1 class="text-2xl font-medium">Add provider</h1>
    <p class="max-w-prose text-sm text-base-content/60">Connect a hosted or local model endpoint. After saving, add its models and enable the provider.</p>
  </header>
  <%= render "definition_form", form: @form, url: admin_model_providers_path, method: :post, creating: true %>
</div>
