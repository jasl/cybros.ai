<% provider_name = model_provider_name(provider.fetch(:id), display_name: provider[:display_name]) %>
<header class="space-y-4">
  <%= render "shared/back_navigation",
    path: current == :overview ? admin_model_providers_path : admin_model_provider_path(provider.fetch(:id)),
    label: current == :overview ? "Model providers" : provider_name %>
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div class="min-w-0 space-y-1">
      <h1 class="text-xl font-medium tracking-tight wrap-anywhere"><%= local_assigns.fetch(:title, provider_name) %></h1>
      <p class="text-sm text-base-content/60"><%= description %></p>
    </div>
    <span class="<%= badge_classes(provider.fetch(:enabled), tone: :success) %>"><%= provider.fetch(:enabled) ? "Enabled" : "Disabled" %></span>
  </div>
</header>
