<header class="space-y-4">
  <%= link_to admin_model_providers_path, class: "inline-flex items-center gap-1.5 text-sm text-base-content/60 hover:text-base-content" do %>
    <span class="iconify lucide--arrow-left size-4" aria-hidden="true"></span>
    Model providers
  <% end %>
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div class="min-w-0 space-y-1">
      <h1 class="text-2xl font-medium tracking-tight wrap-anywhere"><%= model_provider_name(provider.fetch(:id), display_name: provider[:display_name]) %></h1>
      <p class="text-sm text-base-content/60"><%= description %></p>
    </div>
    <span class="<%= badge_classes(provider.fetch(:enabled), tone: :success) %>"><%= provider.fetch(:enabled) ? "Enabled" : "Disabled" %></span>
  </div>
</header>

<% unless current == :overview %>
  <%= link_to "Provider overview", admin_model_provider_path(provider.fetch(:id)), class: "link text-sm" %>
<% end %>
