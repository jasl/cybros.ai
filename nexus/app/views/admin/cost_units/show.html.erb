<% content_for :title, "Cost unit" %>

<div class="max-w-3xl space-y-6">
  <header class="space-y-2">
    <p class="text-xs font-medium uppercase tracking-widest text-base-content/50">System settings</p>
    <h1 class="text-2xl font-medium tracking-tight">Cost unit</h1>
    <p class="max-w-prose text-sm leading-relaxed text-base-content/60">Usage costs use USD by default. This advanced setting shows the unit chosen for this installation.</p>
  </header>
  <% if @account.cost_unit.present? %>
    <section class="rounded-box border border-base-300 bg-base-200 p-5 sm:p-6">
      <p class="text-xs text-base-content/60">Account cost unit</p>
      <p class="mt-2 text-2xl font-medium hyphens-none wrap-anywhere"><%= @account.cost_unit %></p>
      <div class="mt-5 flex items-start gap-2 border-t border-base-300 pt-4 text-sm text-base-content/60">
        <span class="iconify lucide--lock-keyhole mt-0.5 size-4 shrink-0" aria-hidden="true"></span>
        <p>This value is set once and cannot be changed. Nexus does not convert between units.</p>
      </div>
    </section>
    <%= link_to "Configure model providers", admin_model_providers_path, class: "btn btn-primary btn-sm" %>
  <% else %>
    <%= form_with url: admin_cost_unit_path, method: :patch, scope: :account do |form| %>
      <div class="rounded-box border border-base-300 bg-base-200">
        <%= render layout: "shared/form_row", locals: { form: form, attribute: :cost_unit, label: "Cost unit", description: "The included model pricing uses USD." } do %>
          <%= validated_field form, :text_field, :cost_unit, @account.errors.full_messages_for(:cost_unit), value: @cost_unit_input.nil? ? "USD" : @cost_unit_input, required: true, size: :sm, autocomplete: "off" %>
        <% end %>
      </div>
      <div class="mt-4 flex items-start gap-2 text-sm text-base-content/70">
        <span class="iconify lucide--info mt-0.5 size-4 shrink-0" aria-hidden="true"></span>
        <p>This installation has no cost unit yet. Use USD for the included pricing, or match your custom pricing. The unit is set once and cannot be changed.</p>
      </div>
      <div class="mt-5 flex justify-end"><%= form.submit "Set cost unit", class: "btn btn-primary btn-sm", data: { turbo_confirm: "Set this installation's cost unit? It cannot be changed after saving." } %></div>
    <% end %>
  <% end %>
</div>
