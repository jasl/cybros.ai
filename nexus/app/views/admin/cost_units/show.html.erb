<% content_for :title, t("admin.cost_units.show.cost_unit") %>

<div class="space-y-8">
  <header class="space-y-1">
    <h1 class="text-xl font-medium tracking-tight"><%= t("admin.cost_units.show.cost_unit") %></h1>
    <p class="max-w-prose text-sm leading-relaxed text-base-content/60"><%= t("admin.cost_units.show.usage_costs_use_usd_by_default_this_advanced_setting") %></p>
  </header>
  <% if @account.cost_unit.present? %>
    <section class="rounded-box border border-base-300 bg-base-200 p-5 sm:p-6">
      <p class="text-xs text-base-content/60"><%= t("admin.cost_units.show.account_cost_unit") %></p>
      <p class="mt-2 text-2xl font-medium hyphens-none wrap-anywhere"><%= @account.cost_unit %></p>
      <div class="mt-5 flex items-start gap-2 border-t border-base-300 pt-4 text-sm text-base-content/60">
        <span class="iconify lucide--lock-keyhole mt-0.5 size-4 shrink-0" aria-hidden="true"></span>
        <p><%= t("admin.cost_units.show.this_value_is_set_once_and_cannot_be_changed", brand: t("brand.name")) %></p>
      </div>
    </section>
    <div class="flex justify-end">
      <%= link_to t("admin.cost_units.show.configure_model_providers"), admin_model_providers_path, class: "btn btn-sm" %>
    </div>
  <% else %>
    <%= form_with url: admin_cost_unit_path, method: :patch, scope: :account do |form| %>
      <div class="rounded-box border border-base-300 bg-base-200">
        <%= render layout: "shared/form_row", locals: { form: form, attribute: :cost_unit, label: t("admin.cost_units.show.cost_unit"), description: t("admin.cost_units.show.the_included_model_pricing_uses_usd") } do %>
          <%= validated_field form, :text_field, :cost_unit, @account.errors.full_messages_for(:cost_unit), value: @cost_unit_input.nil? ? "USD" : @cost_unit_input, required: true, size: :sm, autocomplete: "off" %>
        <% end %>
      </div>
      <div class="mt-4 flex items-start gap-2 text-sm text-base-content/70">
        <span class="iconify lucide--info mt-0.5 size-4 shrink-0" aria-hidden="true"></span>
        <p><%= t("admin.cost_units.show.this_installation_has_no_cost_unit_yet_use_usd") %></p>
      </div>
      <div class="mt-3 flex justify-end"><%= form.submit t("admin.cost_units.show.set_cost_unit"), class: "btn btn-primary btn-sm", data: { turbo_confirm: t("admin.cost_units.show.set_this_installation_s_cost_unit_it_cannot_be") } %></div>
    <% end %>
  <% end %>
</div>
