<%# locals: (preflight:) %>
<section aria-labelledby="upgrade-checks-heading" class="rounded-box border border-base-300 bg-base-100 p-5 sm:p-6">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <h2 id="upgrade-checks-heading" class="text-lg font-semibold"><%= t("admin.deployments.preflight.upgrade_checks") %></h2>
    <% if preflight %>
      <span class="<%= class_names("badge badge-soft", "badge-success": preflight.ready, "badge-error": !preflight.ready) %>" role="status">
        <%= preflight.ready ? t("admin.deployments.preflight.ready_to_upgrade") : t("admin.deployments.preflight.upgrade_blocked") %>
      </span>
    <% end %>
  </div>
  <% if preflight %>
    <p class="mt-2 text-xs break-words text-base-content/60"><%= t("admin.deployments.preflight.checked_checked_at_the_installation_checks_again_before_starting_an", checked_at: (preflight.checked_at)) %></p>
    <p class="mt-2 text-sm text-base-content/65"><%= preflight.backup ? t("admin.deployments.preflight.includes_a_database_backup_before_migration") : t("admin.deployments.preflight.database_backup_is_skipped_for_this_upgrade") %></p>
    <ul class="mt-4 divide-y divide-base-300">
      <% preflight.checks.each do |check| %>
        <li class="space-y-2 py-4 first:pt-0 last:pb-0" data-preflight-check="<%= check.name %>">
          <div class="flex flex-wrap items-start justify-between gap-2">
            <h3 class="min-w-0 break-words font-medium"><%= check.name.humanize %></h3>
            <span class="<%= class_names("badge badge-soft", "badge-success": check.status == "passed", "badge-error": check.status == "blocked", "badge-warning": check.status == "warning") %>"><%= t("deployment.preflight_statuses.#{check.status}") %></span>
          </div>
          <p class="text-sm break-words"><%= check.message %></p>
          <% if check.next_step.present? %>
            <p class="text-sm break-words text-base-content/75"><span class="font-medium"><%= t("admin.deployments.preflight.next_step") %></span> <%= check.next_step %></p>
          <% end %>
          <% unless check.available_bytes.nil? && check.required_bytes.nil? %>
            <dl class="flex flex-wrap gap-x-6 gap-y-2 text-xs text-base-content/65">
              <% unless check.available_bytes.nil? %>
                <div><dt class="inline"><%= t("admin.deployments.preflight.available") %></dt> <dd class="inline"><%= t("admin.deployments.preflight.size_bytes", size: (number_with_delimiter(check.available_bytes))) %></dd></div>
              <% end %>
              <% unless check.required_bytes.nil? %>
                <div><dt class="inline"><%= t("admin.deployments.preflight.required") %></dt> <dd class="inline"><%= t("admin.deployments.preflight.size_bytes", size: (number_with_delimiter(check.required_bytes))) %></dd></div>
              <% end %>
            </dl>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-2 text-sm text-base-content/65"><%= t("admin.deployments.preflight.run_a_release_check_to_see_whether_this_installation") %></p>
  <% end %>
</section>
