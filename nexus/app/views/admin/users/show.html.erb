<% member_name = member_display_name(@member) %>
<% content_for :title, member_name %>
<% actor = Current.user %>
<% administrable = @member.administrable_by?(actor) %>

<div class="space-y-8">
  <header class="space-y-4">
    <%= render "shared/back_navigation", path: admin_users_path, label: t("admin.users.show.members") %>
    <div class="space-y-1">
      <h1 class="text-xl font-medium tracking-tight wrap-anywhere"><%= member_name %></h1>
      <p class="text-sm text-base-content/60"><%= t("admin.users.show.member_administration") %></p>
    </div>
  </header>

  <section>
    <h2 class="mb-2 text-xs font-medium text-base-content/60"><%= t("admin.users.show.membership") %></h2>
    <%= render "shared/facts_panel", facts: member_facts(@member) %>
    <% if @member.agent? %>
      <% if @member.steward && !@member.steward.active? %>
        <p class="mt-2 text-sm text-warning">
          <%= t("admin.users.show.the_steward_is_not_active_member_data_access_and") %>
        </p>
      <% end %>
    <% end %>
  </section>

  <% if @member.agent? && administrable %>
    <section>
      <h2 class="mb-2 text-xs font-medium text-base-content/60"><%= t("admin.users.show.steward") %></h2>
      <div class="rounded-box border border-base-300 bg-base-200">
        <% steward_description = if @member.removed?
          t("admin.users.show.reassignment_keeps_the_agent_removed_and_its_old_credentials")
        else
          t("admin.users.show.choose_the_active_human_member_responsible_for_this_agent")
        end %>
        <%= render layout: "shared/action_row", locals: { title: t("admin.users.show.reassign_steward"), description: steward_description } do %>
          <%= link_to t("admin.users.show.reassign_steward"), admin_user_steward_path(@member), class: "btn btn-sm btn-ghost" %>
        <% end %>
      </div>
    </section>
  <% end %>

  <% if @member.removed? %>
    <% if @member.agent? %>
      <p class="text-sm text-base-content/60">
        <%= t("admin.users.show.this_agent_membership_is_removed_its_access_and_credentials") %>
      </p>
    <% else %>
      <p class="text-sm text-base-content/60">
        <%= t("admin.users.show.this_membership_is_removed_their_own_access_ended_immediately") %>
      </p>
    <% end %>
  <% elsif !administrable %>
    <p class="text-sm text-base-content/60">
      <% if @member.owner? %>
        <%= t("admin.users.show.the_owner_cannot_be_administered_ownership_moves_only_through") %>
      <% elsif @member == actor %>
        <%= t("admin.users.show.you_cannot_administer_your_own_membership") %>
      <% end %>
    </p>
  <% end %>

  <% if administrable && @member.removed? %>
    <section>
      <h2 class="mb-2 text-xs font-medium text-base-content/60"><%= t("admin.users.show.lifecycle") %></h2>
      <div class="rounded-box border border-base-300 bg-base-200">
        <% restore_description = if @member.agent?
          t("admin.users.show.restores_the_agent_profile_old_credentials_remain_invalid_reconnect")
        else
          t("admin.users.show.reopens_this_human_s_access_with_the_existing_sign")
        end %>
        <%= render layout: "shared/action_row", locals: { title: t("admin.users.show.restore"), description: restore_description } do %>
          <%= button_to t("admin.users.show.restore"), admin_user_restoration_path(@member), method: :post, class: "btn btn-ghost btn-sm" %>
        <% end %>
      </div>
    </section>
  <% end %>

  <% if administrable && !@member.removed? %>
    <% if @member.human? && !@member.owner? %>
      <section>
        <h2 class="mb-2 text-xs font-medium text-base-content/60"><%= t("admin.users.show.role") %></h2>
        <%= form_with url: admin_user_role_path(@member), method: :patch, scope: :role do |form| %>
          <div class="rounded-box border border-base-300 bg-base-200">
            <%= render layout: "shared/form_row", locals: { form:, attribute: :role, label: t("admin.users.show.role") } do %>
              <%= form.select :role, User::Role::ASSIGNABLE_ROLES.map { |role| [t("members.role_options.#{role}"), role] }, { selected: @member.role }, class: "select select-sm w-full" %>
            <% end %>
          </div>
          <div class="mt-3 flex justify-end">
            <%= form.submit t("admin.users.show.update_role"), class: "btn btn-primary btn-sm" %>
          </div>
        <% end %>
      </section>
    <% end %>

    <section>
      <h2 class="mb-2 text-xs font-medium text-base-content/60"><%= t("admin.users.show.lifecycle") %></h2>
      <div class="rounded-box border border-base-300 bg-base-200">
        <% if @member.active? && @member.human? %>
          <%= render layout: "shared/action_row", locals: { title: t("admin.users.show.suspend"), description: t("admin.users.show.immediately_signs_the_member_out_everywhere_reversible") } do %>
            <%= button_to t("admin.users.show.suspend"), admin_user_suspension_path(@member), method: :post, class: "btn btn-ghost btn-sm", data: { turbo_confirm: t("admin.users.show.suspend_member_their_sessions_become_invalid_immediately", member: (@member.display_name)) } %>
          <% end %>
        <% elsif @member.suspended? %>
          <%= render layout: "shared/action_row", locals: { title: t("admin.users.show.reactivate"), description: t("admin.users.show.restores_access_previous_sessions_stay_revoked") } do %>
            <%= button_to t("admin.users.show.reactivate"), admin_user_activation_path(@member), method: :post, class: "btn btn-ghost btn-sm" %>
          <% end %>
        <% end %>
        <% removal_description = if @member.agent?
          t("admin.users.show.revokes_the_agent_s_access_and_credentials_immediately_then")
        else
          t("admin.users.show.ends_this_human_s_access_now_their_managed_agents")
        end %>
        <%= render layout: "shared/action_row", locals: { title: t("admin.users.show.remove"), description: removal_description } do %>
          <% if @member.agent? %>
            <%= button_to t("admin.users.show.remove"), admin_user_removal_path(@member), method: :post, class: "btn btn-error btn-soft btn-sm", data: { turbo_confirm: t("admin.users.show.remove_member_its_credentials_stop_working_immediately_and_related", member: (member_name)) } %>
          <% else %>
            <%= button_to t("admin.users.show.remove"), admin_user_removal_path(@member), method: :post, class: "btn btn-error btn-soft btn-sm", data: { turbo_confirm: t("admin.users.show.remove_member_their_own_access_ends_immediately_and_agents", member: (member_name)) } %>
          <% end %>
        <% end %>
      </div>
    </section>

    <% if actor.owner? && @member.role == "admin" && @member.active? && @member.human? %>
      <section>
        <h2 class="mb-2 text-xs font-medium text-base-content/60"><%= t("admin.users.show.ownership") %></h2>
        <div class="rounded-box border border-base-300 bg-base-200">
          <%= render layout: "shared/action_row", locals: { title: t("admin.users.show.transfer_ownership"), description: t("admin.users.show.you_become_an_administrator_member_becomes_the_owner", member: (member_name)) } do %>
            <%= button_to t("admin.users.show.transfer_ownership"), admin_user_ownership_transfer_path(@member), method: :post, class: "btn btn-error btn-soft btn-sm", data: { turbo_confirm: t("admin.users.show.transfer_ownership_to_member_you_will_become_an_administrator", member: (member_name)) } %>
          <% end %>
        </div>
      </section>
    <% end %>
  <% end %>
</div>
