<% member_name = member_display_name(@member) %>
<% content_for :title, member_name %>
<% actor = Current.user %>
<% administrable = @member.administrable_by?(actor) %>

<div class="space-y-8">
  <header class="space-y-4">
    <%= render "shared/back_navigation", path: admin_users_path, label: t("admin.users.index.users") %>
    <div class="flex flex-wrap items-end justify-between gap-3">
      <div class="space-y-1">
        <h1 class="text-xl font-medium tracking-tight wrap-anywhere"><%= member_name %></h1>
        <p class="text-sm text-base-content/60"><%= t("admin.users.show.description") %></p>
      </div>
      <%= link_to t("budget_console.balance"), admin_user_budgets_path(@member), class: "btn btn-ghost btn-sm" %>
    </div>
  </header>

  <section>
    <h2 class="mb-2 text-xs font-medium text-base-content/60"><%= t("admin.users.show.details") %></h2>
    <%= render "shared/facts_panel", facts: user_facts(@member) %>
  </section>

  <% if @member.removed? %>
    <p class="text-sm text-base-content/60"><%= t("admin.users.show.removed_description") %></p>
  <% elsif !administrable %>
    <p class="text-sm text-base-content/60"><%= t(@member.owner? ? "admin.users.show.owner_protected" : "admin.users.show.self_protected") %></p>
    <%= link_to t("admin.users.show.profile_settings"), settings_profile_path, class: "btn btn-ghost btn-sm" if @member == actor %>
  <% end %>

  <% if administrable && @member.removed? %>
    <section class="rounded-box border border-base-300 bg-base-200">
      <%= render layout: "shared/action_row", locals: { title: t("admin.users.show.restore"), description: t("admin.users.show.restore_description") } do %>
        <%= button_to t("admin.users.show.restore"), admin_user_restoration_path(@member), method: :post, class: "btn btn-primary btn-sm" %>
      <% end %>
    </section>
  <% end %>

  <% if administrable && !@member.removed? %>
    <section>
      <h2 class="mb-2 text-xs font-medium text-base-content/60"><%= t("admin.users.show.role") %></h2>
      <%= form_with url: admin_user_role_path(@member), method: :patch, scope: :role do |form| %>
        <div class="rounded-box border border-base-300 bg-base-200">
          <%= render layout: "shared/form_row", locals: { form:, attribute: :role, label: t("admin.users.show.role"), description: t("admin.users.show.role_description") } do %>
            <%= form.select :role, User::Role::ASSIGNABLE_ROLES.map { |role| [t("members.role_options.#{role}"), role] }, { selected: @member.role }, class: "select select-sm w-full" %>
          <% end %>
        </div>
        <div class="mt-3 flex justify-end"><%= form.submit t("admin.users.show.update_role"), class: "btn btn-primary btn-sm" %></div>
      <% end %>
    </section>

    <section>
      <h2 class="mb-2 text-xs font-medium text-base-content/60"><%= t("admin.users.show.access") %></h2>
      <div class="rounded-box border border-base-300 bg-base-200">
        <% if @member.active? %>
          <%= render layout: "shared/action_row", locals: { title: t("admin.users.show.suspend"), description: t("admin.users.show.suspend_description") } do %>
            <%= button_to t("admin.users.show.suspend"), admin_user_suspension_path(@member), method: :post, class: "btn btn-ghost btn-sm", data: { turbo_confirm: t("admin.users.show.suspend_confirm", name: member_name) } %>
          <% end %>
        <% elsif @member.suspended? %>
          <%= render layout: "shared/action_row", locals: { title: t("admin.users.show.reactivate"), description: t("admin.users.show.reactivate_description") } do %>
            <%= button_to t("admin.users.show.reactivate"), admin_user_activation_path(@member), method: :post, class: "btn btn-ghost btn-sm" %>
          <% end %>
        <% end %>
        <%= render layout: "shared/action_row", locals: { title: t("admin.users.show.remove"), description: t("admin.users.show.remove_description") } do %>
          <%= button_to t("admin.users.show.remove"), admin_user_removal_path(@member), method: :post, class: "btn btn-error btn-soft btn-sm", data: { turbo_confirm: t("admin.users.show.remove_confirm", name: member_name) } %>
        <% end %>
      </div>
    </section>

    <% if actor.owner? && @member.admin? && @member.active? %>
      <section class="rounded-box border border-base-300 bg-base-200">
        <%= render layout: "shared/action_row", locals: { title: t("admin.users.show.transfer_ownership"), description: t("admin.users.show.transfer_description", name: member_name) } do %>
          <%= button_to t("admin.users.show.transfer_ownership"), admin_user_ownership_transfer_path(@member), method: :post, class: "btn btn-error btn-soft btn-sm", data: { turbo_confirm: t("admin.users.show.transfer_confirm", name: member_name) } %>
        <% end %>
      </section>
    <% end %>
  <% end %>
</div>
