<% content_for :title, t("admin.users.new.new_member") %>

<div class="space-y-8">
  <header class="space-y-4">
    <%= render "shared/back_navigation", path: admin_users_path, label: t("admin.users.new.members") %>
    <div class="space-y-1">
      <h1 class="text-xl font-medium tracking-tight"><%= t("admin.users.new.new_member") %></h1>
      <p class="text-sm text-base-content/60">
        <%= t("admin.users.new.mail_less_onboarding_convey_the_temporary_password_out_of") %>
      </p>
    </div>
  </header>

  <% if @creation_errors&.any? %>
    <div role="alert" class="alert alert-error alert-soft">
      <span class="iconify lucide--circle-alert size-5" aria-hidden="true"></span>
      <span><%= t("admin.users.new.the_member_could_not_be_created_check_the_fields") %></span>
    </div>
  <% end %>

  <%= form_with url: admin_users_path, scope: :user do |form| %>
    <div class="rounded-box border border-base-300 bg-base-200">
      <%= render layout: "shared/form_row", locals: { form:, attribute: :display_name, label: t("admin.users.new.display_name") } do %>
        <%= validated_field form, :text_field, :display_name, Array(@creation_errors&.full_messages_for(:display_name)), size: :sm, value: params.dig(:user, :display_name), required: true, maxlength: User::DISPLAY_NAME_MAX_LENGTH %>
      <% end %>
      <%= render layout: "shared/form_row", locals: { form:, attribute: :email, label: t("admin.users.new.email") } do %>
        <%= validated_field form, :email_field, :email, Array(@creation_errors&.full_messages_for(:email)), size: :sm, value: params.dig(:user, :email), required: true %>
      <% end %>
      <%= render layout: "shared/form_row", locals: { form:, attribute: :role, label: t("admin.users.new.role") } do %>
        <%= form.select :role, User::Role::ASSIGNABLE_ROLES.map { |role| [t("members.role_options.#{role}"), role] }, { selected: params.dig(:user, :role) || "member" }, class: "select select-sm w-full" %>
      <% end %>
      <%= render layout: "shared/form_row", locals: { form:, attribute: :password, label: t("admin.users.new.temporary_password") } do %>
        <%= validated_field form, :password_field, :password, Array(@creation_errors&.full_messages_for(:password)), size: :sm, required: true, autocomplete: "new-password", maxlength: 72 %>
      <% end %>
      <%= render layout: "shared/form_row", locals: { form:, attribute: :password_confirmation, label: t("admin.users.new.repeat_temporary_password") } do %>
        <%= validated_field form, :password_field, :password_confirmation, Array(@creation_errors&.full_messages_for(:password_confirmation)), size: :sm, required: true, autocomplete: "new-password", maxlength: 72 %>
      <% end %>
    </div>
    <div class="mt-3 flex justify-end">
      <%= form.submit t("admin.users.new.create_member"), class: "btn btn-primary btn-sm" %>
    </div>
  <% end %>
</div>
