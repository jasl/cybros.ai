<% content_for :title, t("invitation_acceptances.new.join_brand", brand: t("brand.name")) %>

<div class="space-y-8">
  <header class="space-y-1.5 text-center">
    <h1 class="wrap-anywhere text-2xl font-semibold tracking-tight"><%= t("invitation_acceptances.new.join_account", account: (@invitation.account.name)) %></h1>
    <p class="text-base-content/60">
      <%= t("invitation_acceptances.new.invited_as_html", role: tag.span(t("members.roles.#{@invitation.role}"), class: "font-medium"), email: tag.span(@invitation.email, class: "hyphens-none wrap-anywhere font-medium")) %>
    </p>
  </header>

  <%= render "layouts/shared/flash" %>

  <% if @errors.present? %>
    <div role="alert" class="alert alert-error">
      <span class="iconify lucide--circle-alert size-5" aria-hidden="true"></span>
      <span><%= t("invitation_acceptances.new.some_fields_need_attention_before_you_can_join") %></span>
    </div>
  <% end %>

  <%= form_with url: join_path, scope: :acceptance do |form| %>
    <%= hidden_field_tag :token, params[:token] %>
    <fieldset class="fieldset">
      <%= form.label :display_name, t("invitation_acceptances.new.your_name"), class: "label" %>
      <%= validated_field form, :text_field, :display_name, @errors[:display_name], value: @submitted_display_name, required: true, autofocus: true, autocomplete: "name", placeholder: t("invitation_acceptances.new.enter_your_display_name") %>

      <%= form.label :password, t("invitation_acceptances.new.password"), class: "label mt-2" %>
      <%= validated_field form, :password_field, :password, @errors[:password], required: true, autocomplete: "new-password", placeholder: t("invitation_acceptances.new.enter_a_password"), maxlength: 72 %>

      <%= form.label :password_confirmation, t("invitation_acceptances.new.repeat_password"), class: "label mt-2" %>
      <%= validated_field form, :password_field, :password_confirmation, @errors[:password_confirmation], required: true, autocomplete: "new-password", placeholder: t("invitation_acceptances.new.repeat_the_password"), maxlength: 72 %>

      <%= form.submit t("invitation_acceptances.new.accept_invitation"), class: "btn btn-primary btn-block mt-4" %>
    </fieldset>
  <% end %>
</div>
