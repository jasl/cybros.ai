<% content_for :title, "Invitation unavailable" %>

<div class="space-y-6 text-center">
  <header class="space-y-1.5">
    <h1 class="text-2xl font-semibold tracking-tight">This invitation is invalid or has expired</h1>
    <p class="text-base-content/60">
      Ask your administrator for a valid invitation link.
    </p>
  </header>

  <p class="text-sm text-base-content/60">
    <%= link_to "Back to sign in", new_session_path, class: "link link-hover" %>
  </p>
</div>
