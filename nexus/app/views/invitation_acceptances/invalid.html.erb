<% content_for :title, t("invitation_acceptances.invalid.invitation_unavailable") %>

<div class="space-y-6 text-center">
  <header class="space-y-1.5">
    <h1 class="text-2xl font-semibold tracking-tight"><%= t("invitation_acceptances.invalid.this_invitation_is_invalid_or_has_expired") %></h1>
    <p class="text-base-content/60">
      <%= t("invitation_acceptances.invalid.ask_your_administrator_for_a_valid_invitation_link") %>
    </p>
  </header>

  <p class="text-sm text-base-content/60">
    <%= link_to t("invitation_acceptances.invalid.back_to_sign_in"), new_session_path, class: "link link-hover" %>
  </p>
</div>
