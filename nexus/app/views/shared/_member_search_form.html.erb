<%= form_with url: search_url, method: :get, class: "rounded-box border border-base-300 bg-base-200 p-4" do %>
  <fieldset class="fieldset">
    <legend class="fieldset-legend">Find an active member</legend>
    <%= label_tag :query, "Search members", class: "label" %>
    <p class="label">Search by name or email.</p>
    <div class="flex flex-col gap-2 sm:flex-row">
      <%= search_field_tag :query, query,
        maxlength: max_length,
        autocomplete: "off",
        class: "input input-sm min-w-0 grow" %>
      <div class="flex gap-2">
        <%= submit_tag "Search", class: "btn btn-sm btn-primary" %>
        <% if query.present? %>
          <%= link_to "Clear", search_url, class: "btn btn-sm btn-ghost" %>
        <% end %>
      </div>
    </div>
  </fieldset>
<% end %>
