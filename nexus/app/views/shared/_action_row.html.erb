<div class="grid min-w-0 gap-3 border-b border-base-300 px-4 py-4 last:border-0 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center sm:gap-6">
  <div class="min-w-0">
    <p class="text-sm"><%= title %></p>
    <% if description.present? %>
      <p class="text-xs text-base-content/60 wrap-anywhere"><%= description %></p>
    <% end %>
  </div>
  <div class="flex justify-end">
    <%= yield %>
  </div>
</div>
