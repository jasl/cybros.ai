<article class="flex flex-wrap items-start justify-between gap-3 p-4">
  <div class="min-w-0 space-y-1">
    <%= link_to work_run_title(run), run_path(run, return_to: request.fullpath), class: "link link-hover font-medium wrap-anywhere" %>
    <p class="text-sm text-base-content/60"><%= run.workspace.name %> · <%= work_status_label(run.status) %></p>
  </div>
  <time class="text-sm text-base-content/60" datetime="<%= run.updated_at.iso8601 %>"><%= l(run.updated_at, format: :short) %></time>
</article>
