<% content_for :title, t("runs_console.graph") %>
<%= tag.div class: "space-y-6", data: run_refresh_data(@run) do %>
  <%= render "runs/header", run: @run, actions: @actions %>
  <h2 class="text-lg font-medium"><%= t("runs_console.graph") %></h2>
  <p class="text-sm text-base-content/60"><%= t("runs_console.graph_window") %></p>
  <% if @graph.nodes.any? %>
    <% positions = run_graph_positions(@graph) %>
    <% width = positions.values.map(&:first).max + 240 %>
    <% height = positions.values.map(&:last).max + 85 %>
    <div class="max-h-128 min-w-0 max-w-full overflow-auto rounded-box border border-base-300" tabindex="0" aria-label="<%= t('runs_console.graph_navigation') %>">
      <svg width="<%= width %>" height="<%= height %>" viewBox="0 0 <%= width %> <%= height %>" role="img" aria-labelledby="run-graph-title" class="text-base-content">
        <title id="run-graph-title"><%= t("runs_console.graph_window") %></title>
        <defs><marker id="run-graph-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M 0 0 L 10 5 L 0 10 z" fill="currentColor" /></marker></defs>
        <% @graph.edges.each do |edge| %>
          <path d="<%= run_graph_edge_path(edge, positions) %>" fill="none" stroke="currentColor" stroke-opacity="0.5" marker-end="url(#run-graph-arrow)" />
        <% end %>
        <% @graph.nodes.each do |node| %>
          <% x, y = positions.fetch(node.key) %>
          <a href="<%= run_task_path(@run, node.key, return_to: request.fullpath) %>">
            <title><%= node.key %> · <%= work_status_label(node.status) %></title>
            <rect x="<%= x %>" y="<%= y %>" width="190" height="65" rx="8" fill="var(--color-base-200)" stroke="currentColor" stroke-width="<%= node.deliverable ? 2 : 1 %>" />
            <text x="<%= x + 12 %>" y="<%= y + 25 %>" fill="currentColor" font-size="13"><%= truncate(node.key, length: 22) %></text>
            <text x="<%= x + 12 %>" y="<%= y + 47 %>" fill="currentColor" font-size="11"><%= work_status_label(node.status) %></text>
          </a>
        <% end %>
      </svg>
    </div>
  <% end %>
  <ol class="space-y-3"><% @graph.nodes.each do |node| %>
    <li class="rounded-box border border-base-300 p-4" data-task-key="<%= node.key %>">
      <div class="flex flex-wrap items-center gap-3"><%= link_to node.key, run_task_path(@run, node.key, return_to: request.fullpath), class: "link link-hover font-mono wrap-anywhere" %><span class="badge badge-outline"><%= work_status_label(node.status) %></span><% if node.deliverable %><span class="badge badge-primary"><%= t("runs_console.deliverable") %></span><% end %></div>
      <p class="mt-2 text-sm"><%= t("runs_console.dependencies") %>: <% parents = @graph.edges.select { |edge| edge.to == node.key } %><% if parents.empty? %><%= t("runs_console.no_local_dependencies") %><% else %><% parents.each do |edge| %><%= link_to edge.from, run_task_path(@run, edge.from, return_to: request.fullpath), class: "link link-hover font-mono wrap-anywhere" %> → <%= node.key %> <% end %><% end %></p>
    </li>
  <% end %></ol>
  <% if @page.next_after %><%= link_to t("runs_console.next_page"), run_graph_path(@run, **run_console_parameters.merge("after" => @page.next_after)), class: "btn btn-ghost btn-sm" %><% end %>
  <details class="rounded-box border border-base-300 p-4"><summary class="cursor-pointer font-medium"><%= t("runs_console.mermaid") %></summary><pre class="mt-3 overflow-x-auto text-xs"><%= @graph.mermaid %></pre></details>
<% end %>
