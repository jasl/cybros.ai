<% content_for :title, t("agent_resources.configuration.title") %>

<div class="space-y-8">
  <header class="space-y-3">
    <%= render "shared/back_navigation", path: agent_path(@agent), label: @agent.display_name %>
    <h1 class="text-xl font-medium tracking-tight"><%= t("agent_resources.configuration.title") %></h1>
    <p class="text-sm text-base-content/60"><%= t("agent_resources.configuration.ownership") %></p>
  </header>

  <%= render "agents/declaration_summary", declaration: @declaration.fetch(:configuration) %>

  <%= render "shared/facts_panel", facts: {
    t("agent_resources.configuration.agent_updated") => l(@declaration.fetch(:agent_updated_at), format: :long),
    t("agent_resources.configuration.measured") => l(@declaration.fetch(:measured_at), format: :long),
  } %>

  <details class="rounded-box border border-base-300 bg-base-200 p-4">
    <summary class="cursor-pointer text-sm font-medium"><%= t("agent_resources.configuration.full") %></summary>
    <pre class="mt-3 max-w-full overflow-x-auto whitespace-pre-wrap text-xs wrap-anywhere"><%= JSON.pretty_generate(@declaration.fetch(:configuration)) %></pre>
  </details>

  <section class="space-y-3">
    <h2 class="text-sm font-medium"><%= t("agent_resources.configuration.prompt_documents") %></h2>
    <% if @declaration.fetch(:prompt_documents).empty? %>
      <p class="text-sm text-base-content/60"><%= t("agent_resources.configuration.no_documents") %></p>
    <% end %>
    <% @declaration.fetch(:prompt_documents).each do |document| %>
      <details class="rounded-box border border-base-300 bg-base-200 p-4" data-prompt-slot="<%= document.fetch(:slot) %>">
        <summary class="cursor-pointer text-sm font-medium"><%= document.fetch(:slot) %></summary>
        <p class="mt-3 text-xs text-base-content/60"><%= t("agent_resources.configuration.document_facts", role: document.fetch(:role), version: document.fetch(:version), bytes: document.fetch(:bytesize), written: l(document.fetch(:written_at), format: :long)) %></p>
        <pre class="mt-3 max-w-full overflow-x-auto whitespace-pre-wrap text-sm wrap-anywhere"><%= document.fetch(:content) %></pre>
      </details>
    <% end %>
  </section>
</div>
