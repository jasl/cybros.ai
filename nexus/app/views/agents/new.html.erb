<% content_for :title, t("agents.new.title") %>

<div class="space-y-6">
  <%= render "shared/back_navigation", path: agents_path, label: t("agents.index.my_agents") %>
  <div class="space-y-1">
    <h1 class="text-xl font-medium tracking-tight"><%= t("agents.new.title") %></h1>
    <p class="text-sm text-base-content/60"><%= t("agents.new.description") %></p>
  </div>
  <%= form_with model: @agent, url: agents_path, scope: :agent do |form| %>
    <div class="rounded-box border border-base-300 bg-base-200">
      <%= render layout: "shared/form_row", locals: { form:, attribute: :display_name, label: t("agents.new.name") } do %>
        <%= validated_field form, :text_field, :display_name, @agent.errors.full_messages_for(:display_name), size: :sm, required: true, maxlength: User::DISPLAY_NAME_MAX_LENGTH %>
      <% end %>
    </div>
    <div class="mt-3 flex justify-end">
      <%= form.submit t("agents.new.title"), class: "btn btn-primary btn-sm" %>
    </div>
  <% end %>
</div>
