<% content_for :title, t("agents.private_runners.create") %>

<div class="space-y-6">
  <%= render "shared/back_navigation", path: agent_private_runners_path(@agent), label: t("agents.private_runners.title") %>
  <h1 class="text-xl font-medium tracking-tight"><%= t("agents.private_runners.create") %></h1>
  <%= form_with model: @private_runner, url: agent_private_runners_path(@agent), scope: :private_runner do |form| %>
    <div class="rounded-box border border-base-300 bg-base-200">
      <%= render layout: "shared/form_row", locals: { form:, attribute: :display_name, label: t("agents.new.name") } do %>
        <%= validated_field form, :text_field, :display_name, @private_runner.errors.full_messages_for(:display_name), size: :sm, required: true, maxlength: Executor::DISPLAY_NAME_MAX_LENGTH %>
      <% end %>
    </div>
    <% @private_runner.errors.full_messages.reject { |message| @private_runner.errors.full_messages_for(:display_name).include?(message) }.each do |message| %>
      <p role="alert" class="mt-2 text-sm text-error"><%= message %></p>
    <% end %>
    <div class="mt-3 flex justify-end"><%= form.submit t("agents.private_runners.create"), class: "btn btn-primary btn-sm" %></div>
  <% end %>
</div>
