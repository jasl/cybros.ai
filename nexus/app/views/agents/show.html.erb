<% content_for :title, @agent.display_name %>

<div class="space-y-8">
  <header class="space-y-4">
    <%= render "shared/back_navigation", path: agents_path, label: t("agents.show.my_agents") %>
    <div class="space-y-1">
      <h1 class="text-xl font-medium tracking-tight wrap-anywhere"><%= @agent.display_name %></h1>
      <p class="text-sm text-base-content/60"><%= t("agents.show.agent") %></p>
    </div>
  </header>

  <section>
    <h2 class="mb-2 text-xs font-medium text-base-content/60"><%= t("agents.show.agent") %></h2>
    <%# A named definition carries its declarer, its scope and its description;
        it has no registration of its own — the registration section below shows none. %>
    <%= render "shared/facts_panel", facts: {
      t("agents.show.status") => @agent.active? ? t("agents.show.active") : t("agents.show.removed"),
      t("agents.show.created") => l(@agent.created_at.to_date, format: :long),
      **(@agent.named_definition? ? {
        t("agents.show.defined_by") => t("agents.show.definition_origin", name: @agent.derived_from&.display_name || t("agents.show.removed_program"), definition_scope: t("agents.definition_scopes.#{@agent.definition_scope}")),
        t("agents.show.description") => @agent.description,
      } : {}),
    } %>
    <%# THE HANDLE: assigned by the kernel, renamed by the steward here. %>
    <%= form_with url: agent_handle_path(@agent), method: :patch, scope: :handle, class: "mt-3" do |form| %>
      <div class="rounded-box border border-base-300 bg-base-200">
        <%= render layout: "shared/form_row", locals: { form:, attribute: :handle, label: t("agents.show.handle"), description: t("agents.show.how_others_address_this_agent_handle_lowercase_letters_digits") } do %>
          <%= validated_field form, :text_field, :handle, @agent.errors.full_messages_for(:handle), size: :sm, value: @agent.handle, required: true, maxlength: User::Handle::MAX_LENGTH %>
        <% end %>
      </div>
      <div class="mt-3 flex justify-end">
        <%= form.submit t("agents.show.rename"), class: "btn btn-primary btn-sm" %>
      </div>
    <% end %>
    <% unless @agent.active? %>
      <p class="mt-2 text-sm text-warning">
        <%= t("agents.show.this_agent_is_removed_its_access_and_credentials_are") %>
      </p>
    <% end %>
  </section>

  <section class="space-y-3">
    <div>
      <h2 class="text-xs font-medium text-base-content/60"><%= t("agents.show.registration") %></h2>
      <p class="mt-1 text-sm text-base-content/60">
        <%= t("agents.show.this_agent_can_have_at_most_one_durable_registered") %>
      </p>
    </div>

    <% if @current_address %>
      <% client_name = @current_address.display_name.presence || @agent.display_name %>
      <div class="rounded-box border border-base-300 bg-base-200 px-4 py-4"
        data-address-id="<%= @current_address.public_id %>">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-6">
          <div class="sm:w-1/2">
            <span class="block font-medium wrap-anywhere"><%= client_name %></span>
            <span class="<%= badge_classes(@credential_readiness == :ready, tone: :success, extra: "mt-1 whitespace-nowrap") %>">
              <%= t("executors.credential_readiness.#{@credential_readiness}") %>
            </span>
          </div>
          <div class="text-sm text-base-content/60 sm:w-1/3">
            <% if @current_lineage %>
              <p title="<%= @current_lineage.created_at.iso8601 %>">
                <%= t("agents.show.credentials_issued_elapsed_ago", elapsed: (time_ago_in_words(@current_lineage.created_at))) %>
              </p>
              <p>
                <%= t("agents.show.credential_last_used_last_used", last_used: (@current_lineage.last_used_at ? t("agents.show.elapsed_ago", elapsed: (time_ago_in_words(@current_lineage.last_used_at))) : t("agents.show.never"))) %>
              </p>
            <% else %>
              <p><%= t("agents.show.no_credentials_issued_for_this_registration") %></p>
            <% end %>
            <%= render "agents/last_seen", address: @address %>
          </div>
          <div class="flex grow justify-end">
            <%= button_to t("agents.show.revoke_credentials"),
              agent_credentials_path(@agent),
              method: :delete,
              class: "btn btn-error btn-soft btn-sm whitespace-nowrap",
              aria: { label: t("agents.show.revoke_credentials_for_name", name: (client_name)) },
              data: { turbo_confirm: t("agents.show.revoke_credentials_for_name_it_ends_this_registration_and", name: (client_name)) } %>
          </div>
        </div>
      </div>
    <% else %>
      <div class="rounded-box border border-base-300 bg-base-200 px-6 py-10 text-center">
        <p class="text-sm font-medium"><%= t("agents.show.not_registered") %></p>
        <p class="mx-auto mt-1 max-w-md text-sm text-base-content/60">
          <%= t("agents.show.start_the_program_on_the_machine_you_want_it") %>
        </p>
        <%# A terminal address remains as history until dependency-safe reap. %>
        <p class="mt-3 text-sm text-base-content/60">
          <%= render "agents/last_seen", address: @address %>
        </p>
      </div>
    <% end %>
  </section>

  <section>
    <h2 class="mb-2 text-xs font-medium text-base-content/60"><%= t("agents.show.lifecycle") %></h2>
    <div class="rounded-box border border-base-300 bg-base-200">
      <% if @agent.active? %>
        <%= render layout: "shared/action_row", locals: {
          title: t("agents.show.remove"),
          description: t("agents.show.revokes_this_profile_s_access_immediately_and_force_stops"),
        } do %>
          <%= button_to t("agents.show.remove"),
            agent_removal_path(@agent),
            method: :post,
            class: "btn btn-error btn-soft btn-sm",
            data: { turbo_confirm: t("agents.show.remove_name_its_credentials_stop_working_immediately_and_related", name: (@agent.display_name)) } %>
        <% end %>
      <% else %>
        <%= render layout: "shared/action_row", locals: {
          title: t("agents.show.restore"),
          description: t("agents.show.reopens_the_profile_reconnect_the_program_to_get_new"),
        } do %>
          <%= button_to t("agents.show.restore"), agent_restoration_path(@agent), method: :post, class: "btn btn-ghost btn-sm" %>
        <% end %>
      <% end %>
    </div>
  </section>
</div>
