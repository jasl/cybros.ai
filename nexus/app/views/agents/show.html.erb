<% content_for :title, @agent.display_name %>

<div class="space-y-8">
  <header class="space-y-4">
    <%= render "shared/back_navigation", path: agents_path, label: "My agents" %>
    <div class="space-y-1">
      <h1 class="text-xl font-medium tracking-tight wrap-anywhere"><%= @agent.display_name %></h1>
      <p class="text-sm text-base-content/60">Agent</p>
    </div>
  </header>

  <section>
    <h2 class="mb-2 text-xs font-medium text-base-content/60">Agent</h2>
    <%# A named definition carries its declarer, its scope and its description;
        it has no registration of its own — the registration section below shows none. %>
    <%= render "shared/facts_panel", facts: {
      "Status" => @agent.active? ? "Active" : "Removed",
      "Created" => @agent.created_at.to_date.to_fs(:long),
      **(@agent.named_definition? ? {
        "Defined by" => "#{@agent.derived_from&.display_name || "a removed program"} (#{@agent.definition_scope})",
        "Description" => @agent.description,
      } : {}),
    } %>
    <%# THE HANDLE: assigned by the kernel, renamed by the steward here. %>
    <%= form_with url: agent_handle_path(@agent), method: :patch, scope: :handle, class: "mt-3" do |form| %>
      <div class="rounded-box border border-base-300 bg-base-200">
        <%= render layout: "shared/form_row", locals: { form:, attribute: :handle, label: "Handle", description: "How others address this agent: @handle. Lowercase letters, digits, - and _; 2 to 32 characters; unique here." } do %>
          <%= validated_field form, :text_field, :handle, @agent.errors.full_messages_for(:handle), size: :sm, value: @agent.handle, required: true, maxlength: User::Handle::MAX_LENGTH %>
        <% end %>
      </div>
      <div class="mt-3 flex justify-end">
        <%= form.submit "Rename", class: "btn btn-primary btn-sm" %>
      </div>
    <% end %>
    <% unless @agent.active? %>
      <p class="mt-2 text-sm text-warning">
        This Agent is removed: its access and credentials are revoked.
        Related conversations are being force-stopped in the background.
      </p>
    <% end %>
  </section>

  <section class="space-y-3">
    <div>
      <h2 class="text-xs font-medium text-base-content/60">Registration</h2>
      <p class="mt-1 text-sm text-base-content/60">
        This Agent can have at most one durable registered address. Connecting a
        replacement device re-pairs that address and invalidates the previous credentials.
        Credential readiness says only whether current transport credentials can authenticate —
        it does not mean the program is online. Work already running does not move and follows its
        own reconciliation policy.
      </p>
    </div>

    <% if @current_address %>
      <% client_name = @current_address.display_name.presence || @agent.display_name %>
      <div class="rounded-box border border-base-300 bg-base-200 px-4 py-4"
        data-address-id="<%= @current_address.public_id %>">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-6">
          <div class="sm:w-1/2">
            <span class="block font-medium wrap-anywhere"><%= client_name %></span>
            <span class="<%= badge_classes(@credential_readiness == :ready, tone: :success, extra: "mt-1 whitespace-nowrap") %>">
              <%= t("executors.credential_readiness.#{@credential_readiness}") %>
            </span>
          </div>
          <div class="text-sm text-base-content/60 sm:w-1/3">
            <% if @current_lineage %>
              <p title="<%= @current_lineage.created_at.iso8601 %>">
                Credentials issued <%= time_ago_in_words(@current_lineage.created_at) %> ago
              </p>
              <p>
                Credential last used
                <%= @current_lineage.last_used_at ? "#{time_ago_in_words(@current_lineage.last_used_at)} ago" : "never" %>
              </p>
            <% else %>
              <p>No credentials issued for this registration</p>
            <% end %>
            <%= render "agents/last_seen", address: @address %>
          </div>
          <div class="flex grow justify-end">
            <%= button_to "Revoke credentials",
              agent_credentials_path(@agent),
              method: :delete,
              class: "btn btn-error btn-soft btn-sm whitespace-nowrap",
              aria: { label: "Revoke credentials for #{client_name}" },
              data: { turbo_confirm: "Revoke credentials for #{client_name}? It ends this registration and invalidates any current credentials immediately. The profile and its data stay; connecting again creates a new registration." } %>
          </div>
        </div>
      </div>
    <% else %>
      <div class="rounded-box border border-base-300 bg-base-200 px-6 py-10 text-center">
        <p class="text-sm font-medium">Not registered</p>
        <p class="mx-auto mt-1 max-w-md text-sm text-base-content/60">
          Start the program on the machine you want it to run on and follow the link it prints.
        </p>
        <%# A terminal address remains as history until dependency-safe reap. %>
        <p class="mt-3 text-sm text-base-content/60">
          <%= render "agents/last_seen", address: @address %>
        </p>
      </div>
    <% end %>
  </section>

  <section>
    <h2 class="mb-2 text-xs font-medium text-base-content/60">Lifecycle</h2>
    <div class="rounded-box border border-base-300 bg-base-200">
      <% if @agent.active? %>
        <%= render layout: "shared/action_row", locals: {
          title: "Remove",
          description: "Revokes this profile's access immediately and force-stops related conversations in the background.",
        } do %>
          <%= button_to "Remove",
            agent_removal_path(@agent),
            method: :post,
            class: "btn btn-error btn-soft btn-sm",
            data: { turbo_confirm: "Remove #{@agent.display_name}? Its credentials stop working immediately and related conversations are force-stopped in the background." } %>
        <% end %>
      <% else %>
        <%= render layout: "shared/action_row", locals: {
          title: "Restore",
          description: "Reopens the profile. Reconnect the program to get new credentials.",
        } do %>
          <%= button_to "Restore", agent_restoration_path(@agent), method: :post, class: "btn btn-ghost btn-sm" %>
        <% end %>
      <% end %>
    </div>
  </section>
</div>
