<% content_for :title, @workspace.name %>
<% manageable = @workspace.manageable_by?(Current.user) %>

<div class="space-y-8">
  <header class="space-y-4">
    <%= render "shared/back_navigation", path: workspaces_path, label: t("workspaces.show.workspaces") %>
    <div class="space-y-1">
      <div class="flex flex-wrap items-center gap-2">
        <h1 class="text-xl font-medium tracking-tight wrap-anywhere"><%= @workspace.name %></h1>
        <%= render "workspaces/state_badge", workspace: @workspace %>
        <% if @workspace.agent_identifier %>
          <%= render "workspaces/agent_badge" %>
        <% end %>
      </div>
      <p class="text-sm text-base-content/60"><%= t("workspaces.show.workspace") %></p>
    </div>
  </header>

  <section>
    <h2 class="mb-2 text-xs font-medium text-base-content/60"><%= t("workspaces.show.details") %></h2>
    <%= render "shared/facts_panel", facts: {
      t("workspaces.show.access") => @workspace.account_wide? ? t("workspaces.show.account_wide") : t("workspaces.show.private"),
      t("workspaces.show.owner") => @workspace.owner == Current.user ? t("workspaces.show.you") : @workspace.owner.display_name,
      t("workspaces.show.created") => l(@workspace.created_at.to_date, format: :long),
    } %>
    <% if @workspace.agent_identifier %>
      <p class="mt-2 text-sm text-base-content/60">
        <%= t("workspaces.show.an_agent_program_created_this_workspace_for_its_own") %>
      </p>
    <% end %>
  </section>

  <% if manageable %>
    <% if @workspace.active? %>
      <section>
        <h2 class="mb-2 text-xs font-medium text-base-content/60"><%= t("workspaces.show.access") %></h2>
        <%= form_with url: workspace_access_mode_path(@workspace), method: :patch, scope: :access_mode do |form| %>
          <div class="rounded-box border border-base-300 bg-base-200">
            <%= render layout: "shared/form_row", locals: {
              form:,
              attribute: :access_mode,
              label: t("workspaces.show.access"),
              description: t("workspaces.show.private_keeps_the_data_to_you_and_your_agents"),
            } do %>
              <%= form.select :access_mode, [[t("workspaces.show.private"), "private"], [t("workspaces.show.account_wide"), "account_wide"]], { selected: @access_mode_selection || @workspace.access_mode }, class: "select select-sm w-full" %>
            <% end %>
          </div>
          <%= form.hidden_field :lock_version, value: @workspace.lock_version %>
          <div class="mt-3 flex justify-end">
            <%= form.submit t("workspaces.show.update_access"), class: "btn btn-primary btn-sm" %>
          </div>
        <% end %>
      </section>

      <section>
        <h2 class="mb-2 text-xs font-medium text-base-content/60"><%= t("workspaces.show.ownership") %></h2>
        <div class="rounded-box border border-base-300 bg-base-200">
          <%= render layout: "shared/action_row", locals: {
            title: t("workspaces.show.edit_details"),
            description: t("workspaces.show.change_the_name_or_update_the_small_json_metadata"),
          } do %>
            <%= link_to t("workspaces.show.edit_details"), edit_workspace_path(@workspace), class: "btn btn-ghost btn-sm" %>
          <% end %>
          <%= render layout: "shared/action_row", locals: {
            title: t("workspaces.show.transfer_ownership"),
            description: t("workspaces.show.hand_this_workspace_to_another_active_member_you_stop"),
          } do %>
            <%= link_to t("workspaces.show.transfer_ownership"), workspace_ownership_transfer_path(@workspace), class: "btn btn-ghost btn-sm" %>
          <% end %>
        </div>
      </section>
    <% end %>

    <% if @workspace.active? || @workspace.archived? %>
      <section>
        <h2 class="mb-2 text-xs font-medium text-base-content/60"><%= t("workspaces.show.lifecycle") %></h2>
        <div class="rounded-box border border-base-300 bg-base-200">
          <% if @workspace.active? %>
            <%= render layout: "shared/action_row", locals: {
              title: t("workspaces.show.archive"),
              description: t("workspaces.show.takes_the_workspace_out_of_the_live_list_and"),
            } do %>
              <%= button_to t("workspaces.show.archive"),
                workspace_archival_path(@workspace),
                method: :post,
                params: { command: { lock_version: @workspace.lock_version } },
                class: "btn btn-ghost btn-sm",
                data: { turbo_confirm: t("workspaces.show.archive_workspace_new_writes_stop_and_it_leaves_the", workspace: (@workspace.name)) } %>
            <% end %>
          <% elsif @workspace.archived? %>
            <%= render layout: "shared/action_row", locals: {
              title: t("workspaces.show.restore"),
              description: t("workspaces.show.brings_the_workspace_back_to_the_live_list_and"),
            } do %>
              <%= button_to t("workspaces.show.restore"),
                workspace_restoration_path(@workspace),
                method: :post,
                params: { command: { lock_version: @workspace.lock_version } },
                class: "btn btn-ghost btn-sm" %>
            <% end %>
          <% end %>
          <%= render layout: "shared/action_row", locals: {
            title: t("workspaces.show.delete"),
            description: t("workspaces.show.removes_the_workspace_and_its_data_from_every_list"),
          } do %>
            <%= button_to t("workspaces.show.delete"),
              workspace_deletion_path(@workspace),
              method: :delete,
              params: { command: { lock_version: @workspace.lock_version } },
              class: "btn btn-error btn-soft btn-sm",
              data: { turbo_confirm: t("workspaces.show.delete_workspace_it_disappears_from_every_list_immediately_its", workspace: (@workspace.name)) } %>
          <% end %>
        </div>
      </section>
    <% else %>
      <p class="text-sm text-base-content/60">
        <%= t("workspaces.show.a_lifecycle_change_is_completing_the_state_above_is") %>
      </p>
    <% end %>
  <% else %>
    <p class="text-sm text-base-content/60">
      <%= t("workspaces.show.only_the_workspace_owner_can_manage_it_you_can") %>
    </p>
  <% end %>
</div>
