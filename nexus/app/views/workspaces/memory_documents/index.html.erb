<%= render layout: "workspaces/data/shell", locals: { workspace: @workspace, data_writable: @data_writable, error: @error, validation_errors: @validation_errors, title: t("data_console.memory.title") } do %>
  <p class="text-sm text-base-content/70"><%= t("data_console.memory.description") %></p>
  <% if @data_writable %><%= link_to t("data_console.memory.new"), new_workspace_memory_document_path(@workspace), class: "btn btn-primary btn-sm" %><% end %>
  <div class="divide-y divide-base-300 rounded-box border border-base-300">
    <% @entries.each do |entry| %>
      <article class="space-y-2 p-4">
        <%= link_to entry.path, workspace_memory_document_path(@workspace, path: entry.path), class: "link link-hover font-mono text-sm wrap-anywhere" %>
        <p class="text-sm text-base-content/60"><%= t("data_console.memory.metadata", version: entry.lock_version, bytes: entry.bytesize, time: l(entry.written_at, format: :long)) %></p>
        <% if entry.description.present? %><p class="text-sm wrap-anywhere"><%= entry.description %></p><% end %>
      </article>
    <% end %>
    <% if @entries.empty? %><p class="p-4 text-sm text-base-content/60"><%= t("data_console.memory.empty") %></p><% end %>
  </div>
<% end %>
