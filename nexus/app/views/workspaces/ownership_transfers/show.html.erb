<% content_for :title, t("workspaces.ownership_transfers.show.transfer_ownership") %>

<div class="space-y-8">
  <header class="space-y-4">
    <%= render "shared/back_navigation", path: workspace_path(@workspace), label: @workspace.name %>
    <div class="space-y-1">
      <h1 class="text-xl font-medium tracking-tight"><%= t("workspaces.ownership_transfers.show.transfer_ownership") %></h1>
      <p class="text-sm text-base-content/60">
        <%= t("workspaces.ownership_transfers.show.transfer_description_html", workspace: tag.span(@workspace.name, class: "font-medium wrap-anywhere")) %>
      </p>
    </div>
  </header>

  <section>
    <%= render "shared/member_search_form",
      search_url: workspace_ownership_transfer_path(@workspace),
      query: @query,
      max_length: Workspaces::OwnershipTransfersController::SEARCH_QUERY_MAX_LENGTH %>
  </section>

  <section class="rounded-box border border-base-300 bg-base-200">
    <% if @candidates.any? %>
      <ul class="list">
        <% @candidates.each do |candidate| %>
          <li class="list-row items-center"
            data-transfer-candidate-id="<%= candidate.public_id %>">
            <div class="list-col-grow min-w-0">
              <p class="font-medium wrap-anywhere"><%= candidate.display_name %></p>
              <p class="text-sm text-base-content/60 hyphens-none wrap-anywhere"><%= candidate.email %></p>
            </div>
            <div class="list-col-wrap justify-self-start sm:justify-self-end sm:[grid-row-start:1]">
              <%= button_to t("workspaces.ownership_transfers.show.transfer"),
                workspace_ownership_transfer_path(@workspace),
                method: :post,
                params: {
                  ownership_transfer: {
                    target_user_public_id: candidate.public_id,
                    lock_version: @workspace.lock_version,
                    query: @query,
                  },
                },
                class: "btn btn-sm btn-primary",
                aria: { label: t("workspaces.ownership_transfers.show.transfer_to_member", member: (candidate.display_name)) },
                data: { turbo_confirm: t("workspaces.ownership_transfers.show.transfer_confirmation", workspace: (@workspace.name), member: (candidate.display_name)) } %>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="px-4 py-10 text-center">
        <p class="text-sm font-medium"><%= t("workspaces.ownership_transfers.show.no_matching_members") %></p>
        <p class="mt-1 text-sm text-base-content/60"><%= t("workspaces.ownership_transfers.show.try_a_different_name_or_email_address") %></p>
      </div>
    <% end %>
  </section>

  <%= render "shared/pagination_footer", pagy: @candidates_pagy, noun: "eligible_members", aria_label: t("workspaces.ownership_transfers.show.transfer_candidates_pages") %>
</div>
