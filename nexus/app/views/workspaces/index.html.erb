<% content_for :title, t("workspaces.index.workspaces") %>

<div class="space-y-8">
  <header class="flex flex-wrap items-end justify-between gap-3">
    <div class="space-y-1">
      <h1 class="text-xl font-medium tracking-tight"><%= t("workspaces.index.workspaces") %></h1>
      <p class="text-sm text-base-content/60"><%= t("workspaces.index.shared_homes_for_the_data_you_and_your_agents") %></p>
    </div>
    <%= link_to t("workspaces.index.new_workspace"), new_workspace_path, class: "btn btn-primary btn-sm" %>
  </header>

  <nav class="tabs tabs-border tabs-sm" aria-label="<%= t("workspaces.index.workspace_lists") %>">
    <%= link_to t("workspaces.index.live"), workspaces_path,
      class: class_names("tab", "tab-active": !@archived_tab),
      aria: { current: (@archived_tab ? nil : "page") } %>
    <%= link_to t("workspaces.index.archived"), workspaces_path(tab: "archived"),
      class: class_names("tab", "tab-active": @archived_tab),
      aria: { current: ("page" if @archived_tab) } %>
  </nav>

  <% if @workspaces.any? %>
    <section class="max-w-full overflow-x-auto rounded-box border border-base-300 bg-base-200">
      <table class="table">
        <thead>
          <tr>
            <th><%= t("workspaces.index.name") %></th>
            <th><%= t("workspaces.index.access") %></th>
            <th><%= t("workspaces.index.state") %></th>
            <th><%= t("workspaces.index.owner") %></th>
            <th><%= t("workspaces.index.created") %></th>
          </tr>
        </thead>
        <tbody>
          <% @workspaces.each do |workspace| %>
            <tr data-workspace-id="<%= workspace.public_id %>">
              <td>
                <%= link_to workspace.name, workspace_path(workspace), class: "link link-hover font-medium wrap-anywhere" %>
                <% if workspace.agent_identifier %>
                  <span class="ml-1 align-middle"><%= render "workspaces/agent_badge" %></span>
                <% end %>
              </td>
              <td>
                <span class="<%= badge_classes(workspace.account_wide?, tone: :info, extra: "whitespace-nowrap") %>">
                  <%= workspace.account_wide? ? t("workspaces.index.account_wide") : t("workspaces.index.private") %>
                </span>
              </td>
              <td><%= render "workspaces/state_badge", workspace: workspace %></td>
              <td class="text-base-content/70 hyphens-none wrap-anywhere">
                <%= workspace.owner == Current.user ? t("workspaces.index.you") : workspace.owner.display_name %>
              </td>
              <td class="text-base-content/60 whitespace-nowrap"><%= l(workspace.created_at.to_date, format: :long) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </section>

    <%= render "shared/pagination_footer", pagy: @workspaces_pagy, noun: "workspaces", aria_label: t("workspaces.index.workspace_pages") %>
  <% elsif @archived_tab %>
    <%= render "shared/empty_state",
      title: t("workspaces.index.the_archive_is_empty"),
      description: t("workspaces.index.archived_workspaces_rest_here_with_their_data_readable_until") %>
  <% else %>
    <%= render "shared/empty_state",
      title: t("workspaces.index.no_workspaces_yet"),
      description: t("workspaces.index.create_a_workspace_for_your_data_or_let_an") %>
  <% end %>
</div>
