<% content_for :title, "New workspace" %>

<div class="mx-auto max-w-2xl space-y-6">
  <header class="space-y-1">
    <%= link_to workspaces_path, class: "inline-flex items-center gap-1.5 text-sm text-base-content/60 hover:text-base-content" do %>
      <span class="iconify lucide--arrow-left size-4" aria-hidden="true"></span>
      Workspaces
    <% end %>
    <h1 class="text-xl font-medium tracking-tight">New workspace</h1>
    <p class="text-sm text-base-content/60">Give your data a home. You will own and manage this workspace.</p>
  </header>

  <% if @name_errors&.any? || @access_mode_errors&.any? %>
    <div role="alert" class="alert alert-error alert-soft">
      <span>The workspace could not be created — check the fields below.</span>
    </div>
  <% end %>

  <%= form_with url: workspaces_path, scope: :workspace do |form| %>
    <div class="rounded-box border border-base-300 bg-base-200">
      <%= render layout: "shared/form_row", locals: { form:, attribute: :name, label: "Name" } do %>
        <%= validated_field form, :text_field, :name, Array(@name_errors), size: :sm,
          value: @submitted_name, required: true, maxlength: Workspace::NAME_MAX_LENGTH, autofocus: true %>
      <% end %>
      <fieldset class="space-y-3 px-4 py-4" aria-describedby="workspace-access-description workspace-access-errors">
        <legend class="sr-only">Access</legend>
        <p class="text-sm font-medium" aria-hidden="true">Access</p>
        <p id="workspace-access-description" class="text-sm text-base-content/60">
          Choose who can use the workspace. Only you can manage its settings.
        </p>
        <div class="flex items-start gap-3 rounded-box border border-base-300 p-4">
          <%= form.radio_button :access_mode, "private", checked: @submitted_access_mode == "private", class: "radio radio-sm mt-0.5", aria: { describedby: "workspace-private-description" } %>
          <span class="min-w-0">
            <%= form.label :access_mode_private, "Private", class: "block cursor-pointer text-sm font-medium" %>
            <span id="workspace-private-description" class="mt-1 block text-sm text-base-content/60">For you and the agents you manage.</span>
          </span>
        </div>
        <div class="flex items-start gap-3 rounded-box border border-base-300 p-4">
          <%= form.radio_button :access_mode, "account_wide", checked: @submitted_access_mode == "account_wide", class: "radio radio-sm mt-0.5", aria: { describedby: "workspace-account-wide-description" } %>
          <span class="min-w-0">
            <%= form.label :access_mode_account_wide, "Account-wide", class: "block cursor-pointer text-sm font-medium" %>
            <span id="workspace-account-wide-description" class="mt-1 block text-sm text-base-content/60">For all members of this installation and their agents.</span>
          </span>
        </div>
        <%= validator_hints(Array(@access_mode_errors), id: "workspace-access-errors") %>
      </fieldset>
      <div class="flex flex-wrap items-center justify-end gap-2 border-t border-base-300 px-4 py-4">
        <%= link_to "Cancel", workspaces_path, class: "btn btn-ghost btn-sm" %>
        <%= form.submit "Create workspace", class: "btn btn-primary btn-sm" %>
      </div>
    </div>
  <% end %>
</div>
