<%# locals: (variant:, run_public_id:, origin:, kind:) %>
<% background_input = %w[child task_result].include?(origin) %>
<div class="space-y-3" data-variant-id="<%= variant.fetch(:public_id) %>">
  <div class="flex flex-wrap items-center gap-2 text-sm">
    <span class="badge badge-ghost"><%= t("conversation_console.variant_status.#{variant.fetch(:status)}") %></span>
    <% if variant[:active] %><span class="badge badge-outline"><%= t("conversation_console.active_variant") %></span><% end %>
    <% if run_public_id %><%= link_to t("conversation_console.view_run"), run_path(run_public_id, return_to: request.fullpath), class: "link link-hover" %><% end %>
  </div>
  <% if variant[:prompt_text].present? %>
    <% if background_input %>
      <details class="rounded-box bg-base-300/40 p-3">
        <summary class="cursor-pointer text-sm"><%= t("conversation_console.background_input") %></summary>
        <div class="mt-3"><%= render "work/content", text: variant.fetch(:prompt_text) %></div>
      </details>
    <% else %>
      <div class="rounded-box bg-base-300/40 p-3">
        <p class="mb-2 text-xs font-medium text-base-content/60"><%= t("conversation_console.prompt") %></p>
        <%= render "work/content", text: variant.fetch(:prompt_text) %>
      </div>
    <% end %>
  <% end %>
  <% if variant[:content].present? %>
    <% if background_input && kind == "message" %>
      <details class="rounded-box bg-base-300/40 p-3">
        <summary class="cursor-pointer text-sm"><%= t("conversation_console.background_input") %></summary>
        <div class="mt-3"><%= render "work/content", text: variant.fetch(:content) %></div>
      </details>
    <% else %>
      <%= render "work/content", text: variant.fetch(:content) %>
    <% end %>
  <% else %>
    <p class="text-sm text-base-content/60"><%= t("conversation_console.no_content") %></p>
  <% end %>
  <%= render "work/attachments", attachments: variant[:attachments] %>
  <% if variant[:details_pruned_at] %>
    <p class="rounded-box border border-base-300 p-3 text-sm"><%= t("conversation_console.details_pruned") %></p>
  <% end %>
</div>
