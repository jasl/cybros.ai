<% content_for :title, @heading %>
<div class="space-y-6">
  <%= render "shared/back_navigation", path: work_return_path(conversation_path(@conversation)), label: conversation_title(@conversation) %>
  <h1 class="text-xl font-medium tracking-tight"><%= @heading %></h1>
  <%= render "conversations/list", conversations: @conversations, return_to: request.fullpath %>
  <%= render "shared/pagination_footer", pagy: @conversations_pagy, noun: "conversations", aria_label: t("conversation_console.pages") %>
</div>
