<% content_for :title, t("setups.show.set_up_brand", brand: t("brand.name")) %>

<div class="space-y-8">
  <header class="space-y-1.5 text-center">
    <h1 class="text-2xl font-semibold tracking-tight"><%= t("setups.show.set_up_brand", brand: t("brand.name")) %></h1>
    <p class="text-sm leading-relaxed text-base-content/60"><%= t("setups.show.create_your_administrator_account_to_get_started") %></p>
  </header>

  <%= render "layouts/shared/flash" %>

  <% if @setup.errors.any? %>
    <div role="alert" class="alert alert-error">
      <span class="iconify lucide--circle-alert size-5" aria-hidden="true"></span>
      <span><%= t("setups.show.some_fields_need_attention_before_the_installation_can_be") %></span>
    </div>
  <% end %>

  <%= form_with model: @setup, url: setup_path, data: { controller: "setup-secret", action: "turbo:submit-end->setup-secret#submitted" } do |form| %>
    <%= hidden_field_tag :return_to, params.permit(:return_to)[:return_to] %>
    <fieldset class="fieldset">
      <%= form.label :account_name, t("setups.show.installation_name"), class: "label" %>
      <%= validated_field form, :text_field, :account_name, @setup.errors[:account_name], placeholder: Setup.default_account_name %>

      <%= form.label :display_name, t("setups.show.your_name"), class: "label mt-2" %>
      <%= validated_field form, :text_field, :display_name, @setup.errors[:display_name], required: true, autofocus: true, autocomplete: "name", placeholder: t("setups.show.enter_your_display_name") %>

      <%= form.label :email, t("setups.show.email"), class: "label mt-2" %>
      <%= validated_field form, :email_field, :email, @setup.errors[:email], required: true, autocomplete: "username", placeholder: t("setups.show.enter_your_email_address") %>

      <%= form.label :password, t("setups.show.password"), class: "label mt-2" %>
      <%= validated_field form, :password_field, :password, @setup.errors[:password], required: true, autocomplete: "new-password", placeholder: t("setups.show.enter_a_password"), maxlength: 72 %>

      <%= form.label :password_confirmation, t("setups.show.repeat_password"), class: "label mt-2" %>
      <%= validated_field form, :password_field, :password_confirmation, @setup.errors[:password_confirmation], required: true, autocomplete: "new-password", placeholder: t("setups.show.repeat_the_password"), maxlength: 72 %>

      <% if setup_secret_required? %>
        <%= label_tag :setup_secret, t("setups.show.setup_secret"), class: "label mt-2" %>
        <%= password_field_tag :setup_secret, nil, required: true, autocomplete: "off", placeholder: t("setups.show.enter_the_deployment_setup_secret"), class: "input w-full", data: { setup_secret_target: "secret", turbo_permanent: true } %>
      <% end %>

      <%= tag.details open: @setup.errors[:cost_unit].any?, class: "mt-4 rounded-box border border-base-300 p-4" do %>
        <summary class="cursor-pointer text-sm font-medium"><%= t("setups.show.advanced_options") %></summary>
        <div class="mt-4 space-y-2">
          <%= form.label :cost_unit, t("setups.show.cost_unit"), class: "label" %>
          <%= validated_field form, :text_field, :cost_unit, @setup.errors[:cost_unit], autocomplete: "off", placeholder: "USD" %>
          <p class="text-xs leading-relaxed text-base-content/60"><%= t("setups.show.usage_costs_use_usd_by_default_choose_another_unit", brand: t("brand.name")) %></p>
        </div>
      <% end %>

      <%= form.submit t("setups.show.create_installation"), class: "btn btn-primary btn-block mt-4" %>
    </fieldset>
  <% end %>
</div>
