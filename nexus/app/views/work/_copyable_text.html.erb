<%# locals: (text:) %>
<div class="mt-2 min-w-0 space-y-2" data-controller="clipboard" data-clipboard-copied-value="<%= t('work_reading.copied') %>">
  <button type="button" class="btn btn-ghost btn-xs" data-clipboard-target="button" data-action="clipboard#copy"><%= t("work_reading.copy") %></button>
  <pre class="max-w-full overflow-x-auto whitespace-pre-wrap wrap-anywhere text-xs"><code data-clipboard-target="source"><%= work_original_text(text) %></code></pre>
</div>
