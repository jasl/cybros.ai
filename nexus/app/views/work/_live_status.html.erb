<p class="flex flex-wrap items-center gap-2 text-sm text-base-content/60" role="status" aria-live="polite">
  <span data-work-refresh-target="status" data-live="<%= t('runs_console.live') %>" data-disconnected="<%= t('runs_console.disconnected') %>" data-pending="<%= t('runs_console.updates_waiting') %>"><%= t("runs_console.connecting") %></span>
  <button type="button" class="btn btn-ghost btn-xs" data-action="work-refresh#refresh"><%= t("runs_console.refresh") %></button>
</p>
