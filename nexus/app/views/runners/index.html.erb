<% content_for :title, t("runners.index.my_runners") %>

<div class="space-y-8">
  <header class="flex flex-wrap items-end justify-between gap-3">
    <div class="space-y-1">
      <h1 class="text-xl font-medium tracking-tight"><%= t("runners.index.my_runners") %></h1>
      <p class="text-sm text-base-content/60">
        <%= t("runners.index.machines_you_manage_as_execution_capacity_runners_and_tools") %>
      </p>
    </div>
    <%= link_to t("runners.index.connect_runner"), oauth_device_path, class: "btn btn-primary btn-sm" %>
  </header>

  <% if @runners.any? %>
    <section class="max-w-full overflow-x-auto rounded-box border border-base-300 bg-base-200">
      <table class="table">
        <thead>
          <tr>
            <th><%= t("runners.index.machine") %></th>
            <th><%= t("runners.index.scope") %></th>
            <th><%= t("runners.index.credential_readiness") %></th>
            <th><%= t("runners.index.registered") %></th>
            <th><%= t("runners.index.presence") %></th>
            <th class="text-end"><%= t("runners.index.actions") %></th>
          </tr>
        </thead>
        <tbody>
          <% @runners.each do |runner| %>
            <% readiness = @runner_credential_readiness.fetch(runner.id) %>
            <tr data-runner-id="<%= runner.public_id %>">
              <td>
                <span class="block font-medium wrap-anywhere"><%= runner.display_name %></span>
                <span class="block text-xs text-base-content/60" data-executor-kind="<%= runner.executor_kind %>"><%= machine_kind_label(runner.executor_kind) %></span>
              </td>
              <td>
                <span class="<%= badge_classes(runner.account_wide?, tone: :info, extra: "whitespace-nowrap") %>">
                  <%= runner.account_wide? ? t("runners.index.account_wide") : t("runners.index.private") %>
                </span>
              </td>
              <td>
                <span class="<%= badge_classes(readiness == :ready, tone: :success, extra: "whitespace-nowrap") %>">
                  <%= t("executors.credential_readiness.#{readiness}") %>
                </span>
              </td>
              <td class="text-base-content/60 whitespace-nowrap" title="<%= runner.created_at.iso8601 %>">
                <%= t("runners.index.elapsed_ago", elapsed: (time_ago_in_words(runner.created_at))) %>
              </td>
              <td class="text-base-content/60 whitespace-nowrap" title="<%= runner.last_seen_at&.iso8601 %>">
                <%= presence_label(runner) %>
              </td>
              <td class="text-end">
                <div class="flex justify-end gap-1">
                  <%= button_to t("runners.index.revoke_credentials"),
                    runner_credentials_path(runner),
                    method: :delete,
                    class: "btn btn-ghost btn-sm",
                    aria: { label: t("runners.index.revoke_credentials_for_name", name: (runner.display_name)) },
                    data: { turbo_confirm: t("runners.index.revoke_credentials_for_name_it_stops_working_immediately_and", name: (runner.display_name)) } %>
                  <%= button_to t("runners.index.revoke_runner"),
                    runner_path(runner),
                    method: :delete,
                    class: "btn btn-error btn-soft btn-sm",
                    aria: { label: t("runners.index.revoke_name", name: (runner.display_name)) },
                    data: { turbo_confirm: t("runners.index.revoke_name_this_cannot_be_undone_the_machine_loses", name: (runner.display_name)) } %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </section>

    <%= render "shared/pagination_footer", pagy: @runners_pagy, noun: "runners", aria_label: t("runners.index.runner_pages") %>
  <% else %>
    <%= render "shared/empty_state",
      title: t("runners.index.no_runners_connected"),
      description: t("runners.index.a_runner_connects_itself_start_it_on_the_machine") %>
  <% end %>
</div>
