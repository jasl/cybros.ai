<% content_for :title, "Forgot your password?" %>

<div class="space-y-8">
  <header class="space-y-4">
    <%= render "shared/back_navigation", path: new_session_path, label: "Back to sign in" %>
    <div class="space-y-1.5 text-center">
      <h1 class="text-2xl font-semibold tracking-tight">Forgot your password?</h1>
      <% if ApplicationMailer.delivery_configured? %>
        <p class="text-base-content/60">We will email you instructions to reset it</p>
      <% end %>
    </div>
  </header>

  <%= render "layouts/shared/flash" %>

  <% if ApplicationMailer.delivery_configured? %>
    <%= form_with url: passwords_path do |form| %>
      <fieldset class="fieldset">
        <%= form.label :email, "Email", class: "label" %>
        <%= form.email_field :email, required: true, autofocus: true, autocomplete: "username", placeholder: "Enter your email address", value: params[:email], class: "input w-full" %>

        <%= form.submit "Email reset instructions", class: "btn btn-primary btn-block mt-4" %>
      </fieldset>
    <% end %>
  <% else %>
    <div role="alert" class="alert alert-warning">
      <span class="iconify lucide--mail-x size-5" aria-hidden="true"></span>
      <span>Password reset by email is unavailable because this installation has no outbound mail. Contact your administrator.</span>
    </div>
  <% end %>

</div>
