<% content_for :title, t("dashboard.show.dashboard") %>

<div class="space-y-8">
  <header class="space-y-1">
    <h1 class="text-xl font-medium tracking-tight"><%= t("dashboard.show.dashboard") %></h1>
    <p class="text-sm text-base-content/60"><%= t("dashboard.show.signed_in_as_html", email: tag.span(Current.identity.email, class: "wrap-anywhere")) %></p>
  </header>

  <% if @needs_model_provider || @needs_agent %>
    <section aria-labelledby="dashboard-todo-heading" class="space-y-4">
      <h2 id="dashboard-todo-heading" class="text-sm font-medium"><%= t("dashboard.show.to_do") %></h2>
      <div class="grid gap-4 lg:grid-cols-2">
        <% if @needs_model_provider %>
          <article aria-label="<%= t("dashboard.show.model_provider_setup") %>" class="rounded-box border border-base-300 bg-base-200 p-5 sm:p-6">
            <span class="iconify lucide--plug-zap size-5 text-primary" aria-hidden="true"></span>
            <h3 class="mt-4 font-medium"><%= t("dashboard.show.connect_a_model_provider") %></h3>
            <p class="mt-2 max-w-prose text-sm leading-relaxed text-base-content/60"><%= t("dashboard.show.make_a_text_model_available_for_your_agents_this") %></p>
            <%= link_to t("dashboard.show.configure_model_providers"), admin_model_providers_path, class: "btn btn-primary btn-sm mt-5" %>
          </article>
        <% end %>
        <% if @needs_agent %>
          <article aria-label="<%= t("dashboard.show.agent_connection") %>" class="rounded-box border border-base-300 bg-base-200 p-5 sm:p-6">
            <span class="iconify lucide--bot size-5 text-primary" aria-hidden="true"></span>
            <h3 class="mt-4 font-medium"><%= t("dashboard.show.connect_an_agent") %></h3>
            <p class="mt-2 max-w-prose text-sm leading-relaxed text-base-content/60"><%= t("dashboard.show.start_your_agent_program_and_enter_its_connection_code") %></p>
            <%= link_to t("dashboard.show.connect_an_agent"), oauth_device_path, class: "btn btn-primary btn-sm mt-5" %>
          </article>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
