<h1 class="text-xl font-semibold"><%= t("sso.recovery_title") %></h1>
<p class="my-4"><%= t("sso.recovery_help") %></p>
<% @providers.each do |provider| %>
  <%= button_to provider.name, sso_start_path(provider.public_id), params: { purpose: "recovery", recovery_token: @token }, class: "btn btn-primary" %>
<% end %>
