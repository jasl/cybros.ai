# Nexus deployment configuration template.
#
# Copy to the file for the target deployment and fill in the blanks:
#
#   install -m 600 env.sample .env          # optional local overrides or bare metal
#   install -m 600 env.sample .env.docker   # Docker Compose
#
# How it is consumed:
#   - local development and bare-metal production: dotenv loads .env when
#     Rails boots; bin/dev also passes it to foreman-managed processes.
#   - Docker Compose: invoke `docker compose --env-file .env.docker ...` so the
#     CLI uses it for ${...} interpolation; compose.yaml also injects that file
#     into the migrator, app, and jobs containers through `env_file`.
#
# Both files are gitignored; never commit real secrets.

# ==========================================================================
# Secrets (required in production)
# ==========================================================================

# Keep values commented until the deployment needs them. `bin/setup` does not
# create an environment file; copy this template manually when using dotenv or
# Docker Compose. Local development otherwise uses Rails encrypted credentials.
# Do not commit either filled deployment file.
#
#   SECRET_KEY_BASE: bin/rails secret
#   ACTIVE_RECORD_ENCRYPTION__PRIMARY_KEY: openssl rand -hex 32
#   ACTIVE_RECORD_ENCRYPTION__DETERMINISTIC_KEY: openssl rand -hex 32
#   ACTIVE_RECORD_ENCRYPTION__KEY_DERIVATION_SALT: openssl rand -hex 32

# Rails.app.creds reads environment variables populated from the selected
# deployment file.
# SECRET_KEY_BASE=
# ACTIVE_RECORD_ENCRYPTION__PRIMARY_KEY=
# ACTIVE_RECORD_ENCRYPTION__DETERMINISTIC_KEY=
# ACTIVE_RECORD_ENCRYPTION__KEY_DERIVATION_SALT=

# Alternative for deployments that keep those values in their own untracked
# encrypted credentials file: the decryption key Rails reads at runtime.
#RAILS_MASTER_KEY=

# Constant-time-compared shared secret required by the first-boot setup form;
# while unset the setup page needs no extra credential. Ignored
# after the installation is founded.
#NEXUS_SETUP_SECRET=

# Optional provider API keys. After founding the installation, explicitly run
# RAILS_ENV=production bin/rails db:seed to import them into encrypted storage.
# This enables only missing provider lanes and preserves existing disabled lanes;
# removing a variable does not revoke a stored key. The Account cost unit is
# configured separately. Codex subscription OAuth uses its own authorization flow.
#OPENAI_API_KEY=
#ANTHROPIC_API_KEY=
#GEMINI_API_KEY=
#DEEPSEEK_API_KEY=
#XAI_API_KEY=
#OPENROUTER_API_KEY=

# ==========================================================================
# Optional canonical origin
# ==========================================================================

# Set this when clients should always receive links for one stable origin.
# Nexus requires only http(s) and a host; a root DNS origin without userinfo,
# path, query, or fragment is recommended. Direct localhost and LAN-IP
# deployments normally leave this unset so links use each request's origin.
#
# Examples:
#   internal DNS: http://nexus.internal:3300
#   reverse proxy: https://nexus.example.com
#BASE_URL=https://nexus.example.com

# Rails derives both defaults from BASE_URL's scheme when these overrides are
# omitted, or keeps them false in direct mode. Set either override only when the
# deployment topology intentionally differs from that scheme-derived behavior.
#RAILS_ASSUME_SSL=true
#RAILS_FORCE_SSL=true

# Optional asset CDN origin.
#CDN_HOST=

# ==========================================================================
# Database (PostgreSQL 18+)
# ==========================================================================

# Docker Compose only: superuser password for the bundled `db` service. It is
# passed to libpq as PGPASSWORD (never embedded in a URI), so any characters
# are safe. Bare-metal deployments configure PostgreSQL below instead.
POSTGRES_PASSWORD=nexus

# Local or bare-metal external PostgreSQL, option A — connection base WITHOUT
# a database name (URL-encode user/password yourself); each database appends
# its own name.
#RAILS_DB_URL_BASE=postgres://user:password@host:5432
# Local or bare-metal external PostgreSQL, option B — discrete libpq variables
# (no encoding hazard). The default Compose stack reserves PGHOST, PGUSER, and
# PGPASSWORD for its bundled `db`; using an external database with Compose
# requires adjusting compose.yaml rather than setting them in .env.docker.
#PGHOST=
#PGPORT=5432
#PGUSER=
#PGPASSWORD=

# Development/production database name overrides (production defaults shown).
#RAILS_APP_DB_NAME=cybros_nexus_primary_production
#RAILS_CACHE_DB_NAME=cybros_nexus_cache_production
#RAILS_QUEUE_DB_NAME=cybros_nexus_queue_production
#RAILS_CABLE_DB_NAME=cybros_nexus_cable_production

# Test database overrides are separate. Development db:prepare and db:reset also
# prepare test schemas; never point these names at development/production data.
#RAILS_TEST_APP_DB_NAME=cybros_nexus_test
#RAILS_TEST_CABLE_DB_NAME=cybros_nexus_cable_test

# Connection pool override and bounded lock wait. The automatic pool is at
# least 5, or RAILS_MAX_THREADS when that is larger.
#RAILS_DB_POOL=5
#RAILS_DB_LOCK_TIMEOUT=10s

# ==========================================================================
# Web server and jobs
# ==========================================================================

# Docker Compose only: host port that publishes the app.
NEXUS_PORT=3300

# Puma: worker processes / threads per worker. Compose runs `bin/jobs` as a
# separate service; small bare-metal installs may opt into an in-Puma supervisor.
#WEB_CONCURRENCY=1
#RAILS_MAX_THREADS=3
#SOLID_QUEUE_IN_PUMA=true

# Solid Queue worker processes (per supervisor).
#JOB_CONCURRENCY=1

# Rails log level: debug | info | warn | error.
#RAILS_LOG_LEVEL=info

# Thruster records raw query strings, including invitation and password-reset
# capabilities. Keep its access log disabled; Rails still writes its filtered
# request log.
THRUSTER_LOG_REQUESTS=false

# Docker image/Thruster only: backend Puma port. Thruster listens on port 80
# and sets the child process's PORT to TARGET_PORT (default 3000).
#TARGET_PORT=3000
# Direct Puma only (bare metal or bin/rails server without Thruster).
#PORT=3000
#PIDFILE=

# ==========================================================================
# Outbound mail (optional)
# ==========================================================================

# Invitations and password-reset delivery activate only when SMTP_ADDRESS and
# a configured BASE_URL are both set; mail has no request origin from
# which to generate absolute links.
#SMTP_ADDRESS=
#SMTP_PORT=587
#SMTP_DOMAIN=
# When the relay requires SMTP AUTH, set the username, password, and
# authentication mechanism together.
#SMTP_USERNAME=
#SMTP_PASSWORD=
#SMTP_AUTHENTICATION=plain
#SMTP_TLS=false
#SMTP_SSL_VERIFY_MODE=

# Sender ("Name <address>") for application mail.
#MAILER_FROM_ADDRESS=Nexus <no-reply@cybros.ai>
