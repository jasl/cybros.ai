# See https://docs.docker.com/engine/reference/builder/#dockerignore-file for more about ignoring files.

# Ignore git directory.
/.git/
/.gitignore

# Ignore development files
/.devcontainer

# Ignore CI service files.
/.github

# Ignore Kamal files
/.kamal

# Ignore Docker-related files
/.dockerignore
/Dockerfile*

# Vibe coding
/.claude
/AGENTS.md
/CLAUDE.md
/memory

# Docs
/docs

# Below contents are synced from .gitignore

# Generated gem files, including vendored gems.
**/.yardoc
**/_yardoc/
**/doc/
**/pkg/
**/*.gem
**/spec/reports/
.DS_Store

# IDE and Editor specific
/.idea
/.cursor
/.ruby-lsp
/.vscode

# Install dependencies inside the image, without host Bundler state.
**/.bundle/
**/vendor/bundle/
**/vendor/cache/

# MCP temp files
/.playwright-mcp

# Playwright (optional E2E)
**/test-results/
**/playwright-report/
**/blob-report/
**/playwright/.cache/
/playwright.config.ts
/bin/e2e

# Ignore node_modules
**/node_modules/

# Tests (not needed in production image)
/test/

# Simple-cov
**/coverage/

# Python bytecode generated by local tools.
**/__pycache__/
**/*.py[cod]

# Ignore all environment files.
/.env*
!/.env*.erb
!/.env*.sample

# Ignore all logfiles and tempfiles.
/log/*
/tmp/**
/vendor/simple_inference/tmp/
!/log/.keep
!/tmp/.keep
!/tmp/pids/.keep
!/tmp/sockets/.keep
!/tmp/storage/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/shared/

# Ignore SQLite database files.
/db/*.sqlite3
/db/*.sqlite3-*

# Ignore all default key files.
# Key material never enters the image; the ENCRYPTED credentials files do —
# the runtime provides RAILS_MASTER_KEY to decrypt them (standard Rails
# deployment shape).
/config/master.key
/config/credentials/*.key

# Ignore local settings files
/config/settings.local.yml
/config/settings/*.local.yml
/config/environments/*.local.yml

# Ignore runtime override files; mount config.d at runtime instead of baking local overrides into the image.
/config.d/*
!/config.d/.gitignore
!/config.d/.keep

# Ignore environment specified config files
/config/deploy.yml
/compose.yaml

# Assets pipeline
/app/assets/builds/*
!/app/assets/builds/.keep
/public/assets

# Downloaded tokenizer assets are fetched during the image build.
/vendor/tokenizers/*
!/vendor/tokenizers/.keep
!/vendor/tokenizers/README.md
