# Deployment-local SELECTOR overlay. Unlike providers and models there is
# nothing shipped to merge with — naming a selector here is the whole of its
# definition, and naming it twice REPLACES it wholesale (never a recursive
# merge).
#
# `config.d` IS FLAT — a subdirectory inside it is refused, not read. One
# environment tier merges after the generic tier, most specific wins:
#   config.d/model_selectors.yml        generic
#   config.d/model_selectors.<env>.yml  only in that environment
# Recognized environments: development, test, production. A file whose suffix
# looks like an environment but names none refuses compilation rather than
# silently running everywhere.
#
# A selector is an ORDERED candidate list. Acceptance walks it once and
# freezes the first candidate that passes every gate — the lane is enabled,
# a credential resolves, the provider is healthy — so order is policy, not
# preference. A candidate that fails is skipped; an exhausted list refuses.
#
# THIS REPOSITORY SHIPS NO SELECTOR. Routing policy
# is a deployment decision: which models to try, and in what order, is not
# something a library can be right about. So the names below define nothing
# until you uncomment them — and a caller that names a selector nobody defined
# is refused `unknown_model_selector` at acceptance, before any provider call.
#
# COPY THIS FILE AND NOTHING CHANGES. Delete the leading "# " from the
# selector you mean to own, and expect to state its whole candidate list: an
# overlay REPLACES a selector outright rather than adding to it.
schema_version: cybros.model_catalog.v1

# selectors:
#   # A bare model ref is the whole candidate: no reasoning effort is pinned,
#   # so the model's own default applies.
#   interactive_chat:
#     - local/qwen3-32b
#     - local/qwen3-14b
#
#   # Pin an effort by naming it. The two forms mix freely inside one list,
#   # and the model must declare the effort you pin.
#   summarization:
#     - model: local/qwen3-32b
#       reasoning_effort: low
#     - local/qwen3-14b
