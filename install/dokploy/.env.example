CYBROS_IMAGE_TAG=latest
CYBROS_NEXUS_URL=https://nexus.example.com
CYBROS_RHO_URL=https://rho.example.com

# Generate each value independently with: openssl rand -hex 32
# Keep these values when redeploying or restoring the associated volumes.
POSTGRES_PASSWORD=
SECRET_KEY_BASE=
ACTIVE_RECORD_ENCRYPTION__PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION__DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION__KEY_DERIVATION_SALT=

# Leave empty for direct first-owner setup. Optionally set a private value
# to restrict who can create the first owner; retrieve it from Dokploy Environment.
NEXUS_SETUP_SECRET=
