#!/bin/sh
# Local management for the installed stack. Configuration is Compose dotenv,
# never shell code: this script does not source an operator's environment file.
set -eu
umask 077

fail() { printf 'cybros: %s\n' "$*" >&2; exit 1; }
stack_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
cd "$stack_dir"

compose() { docker compose --env-file .env --env-file secrets.env -f compose.yaml "$@"; }

container_exec() {
  if [ -t 0 ] && [ -t 1 ]; then
    compose exec "$@"
  else
    compose exec -T "$@"
  fi
}

prerequisites() {
  command -v docker >/dev/null 2>&1 || fail 'Docker is required. Install Docker Engine with Compose, or Docker Desktop, then retry.'
  docker compose version >/dev/null 2>&1 || fail 'Docker Compose v2 is required.'
  docker info >/dev/null 2>&1 || fail 'The Docker daemon is unavailable. Start Docker or select a working Docker context, then retry.'
  docker compose up --help | grep -q -- --wait-timeout || fail 'Update Docker Compose: up --wait-timeout is required.'
}

setting() {
  # Generated values use single-quoted dotenv literals, including dollar signs.
  # This reader is for display only; Docker Compose parses the actual settings.
  sed -n "s/^$1='\(.*\)'$/\1/p" .env | tail -n 1
}

write_setting() {
  case "$2" in *"'"*|*'
'*) fail "$1 must be a single line without single quotes" ;; esac
  printf "%s='%s'\n" "$1" "$2"
}

secret() {
  generated_secret=$(od -An -N32 -tx1 /dev/urandom | tr -d ' \n')
  [ "${#generated_secret}" -eq 64 ] || fail 'Could not read randomness from /dev/urandom'
  printf '%s' "$generated_secret"
}

initialize() {
  if [ ! -e secrets.env ] && [ -d data ]; then
    # Inspect only the top level: restored PostgreSQL children may belong to
    # its container user. An empty, pre-created data directory is a fresh install.
    for entry in data/* data/.[!.]* data/..?*; do
      if [ -e "$entry" ] || [ -L "$entry" ]; then
        fail 'Existing data has no secrets.env. Restore the original configuration from backup; new secrets cannot unlock this data.'
      fi
    done
  fi
  if { [ -e .env ] && [ ! -e secrets.env ]; } || { [ -e secrets.env ] && [ ! -e .env ]; }; then
    fail 'Only one configuration file exists. Restore the missing file from backup; secrets are never regenerated for an existing installation.'
  fi
  if [ ! -e .env ]; then
    {
      printf '# Compose configuration. Preserve secrets.env and the complete data/ directory.\n'
      write_setting CYBROS_PROJECT_NAME "${CYBROS_PROJECT_NAME:-cybros}"
      write_setting CYBROS_IMAGE_NAMESPACE "${CYBROS_IMAGE_NAMESPACE:-jasl123}"
      write_setting CYBROS_IMAGE_TAG "${CYBROS_IMAGE_TAG:-latest}"
      write_setting CYBROS_BIND "${CYBROS_BIND:-127.0.0.1}"
      write_setting CYBROS_NEXUS_PORT "${CYBROS_NEXUS_PORT:-3300}"
      write_setting CYBROS_RHO_PORT "${CYBROS_RHO_PORT:-7777}"
      write_setting CYBROS_NEXUS_URL "${CYBROS_NEXUS_URL:-http://localhost:${CYBROS_NEXUS_PORT:-3300}}"
      write_setting CYBROS_RHO_URL "${CYBROS_RHO_URL:-http://localhost:${CYBROS_RHO_PORT:-7777}}"
    } > .env.new
    mv .env.new .env
  fi
  if [ ! -e secrets.env ]; then
    {
      printf '# Private deployment secrets. Back up with the database; never rotate encryption keys by reinstalling.\n'
      for key in POSTGRES_PASSWORD SECRET_KEY_BASE ACTIVE_RECORD_ENCRYPTION__PRIMARY_KEY ACTIVE_RECORD_ENCRYPTION__DETERMINISTIC_KEY ACTIVE_RECORD_ENCRYPTION__KEY_DERIVATION_SALT NEXUS_SETUP_SECRET RHO_ACCESS_PASSPHRASE; do
        value=$(secret) || exit 1
        write_setting "$key" "$value"
      done
    } > secrets.env.new
    mv secrets.env.new secrets.env
  fi
  chmod 600 .env secrets.env
}

configured() {
  [ -f .env ] && [ -f secrets.env ] || fail 'Configuration is missing. Run the installer first; do not regenerate secrets for an existing database.'
  # Keep installation-file settings authoritative, even when this command is
  # launched from a shell used to install another stack.
  unset CYBROS_PROJECT_NAME CYBROS_IMAGE_NAMESPACE CYBROS_IMAGE_TAG CYBROS_BIND CYBROS_NEXUS_PORT CYBROS_RHO_PORT CYBROS_NEXUS_URL CYBROS_RHO_URL
  unset POSTGRES_PASSWORD SECRET_KEY_BASE ACTIVE_RECORD_ENCRYPTION__PRIMARY_KEY ACTIVE_RECORD_ENCRYPTION__DETERMINISTIC_KEY ACTIVE_RECORD_ENCRYPTION__KEY_DERIVATION_SALT NEXUS_SETUP_SECRET RHO_ACCESS_PASSPHRASE RHO_TELEGRAM_BOT_TOKEN
  compose config --quiet
}

start() {
  if ! compose up -d --wait --wait-timeout "${CYBROS_WAIT_TIMEOUT:-240}"; then
    compose ps --all >&2 || true
    fail 'Startup did not become healthy. Run ./cybros logs; configuration and data were retained.'
  fi
}

shell_quote() {
  printf "'"
  printf '%s' "$1" | sed "s/'/'\\\\''/g"
  printf "'"
}

working_directory() {
  printf '  cd '
  shell_quote "$stack_dir"
  printf '\n'
}

instructions() {
  [ -f .env ] && [ -f secrets.env ] || fail 'Configuration is missing. Run the installer first.'
  printf '\nNext steps\n'
  working_directory
  printf '\n1. Create your first account: %s/setup\n' "$(setting CYBROS_NEXUS_URL | sed 's:/*$::')"
  printf '   Create your first account using NEXUS_SETUP_SECRET from %s/secrets.env.\n' "$stack_dir"
  printf '\n2. Continue the model, connection and optional Telegram wizard:\n   ./cybros setup\n'
  printf '%s\n' '   Repeat a section with ./cybros setup model or ./cybros setup telegram.'
  printf '\nUse ./cybros status to check services, or ./cybros instructions to see these steps again.\n'
}

setup() {
  configured
  # The installer source may occupy stdin (curl | sh). The wizard must own a
  # real terminal, including Docker's TTY, without consuming shell source.
  if ! (exec 3<> /dev/tty) 2>/dev/null; then
    fail 'Setup needs an interactive terminal. Run ./cybros setup from a terminal; installed services and configuration were retained.'
  fi
  instructions
  if ! compose exec -e CMCTL_HOME=/var/lib/rho/cmctl rho rho setup \
    --nexus-url http://nexus --public-url "$(setting CYBROS_NEXUS_URL)" "$@" \
    </dev/tty >/dev/tty 2>&1; then
    fail 'Setup did not finish. Saved settings were retained; run ./cybros setup to continue.'
  fi
  reload_rho
  # Only the daemon polls Telegram. Start it before the optional first-user
  # step, so /start can report a numeric ID without a second getUpdates reader.
  if ! compose exec -e CMCTL_HOME=/var/lib/rho/cmctl rho rho setup telegram --finish \
    </dev/tty >/dev/tty 2>&1; then
    fail 'Telegram setup did not finish. rho is running; use ./cybros setup telegram to continue.'
  fi
  reload_rho
  printf '\nSetup complete. rho has reloaded its configuration.\n'
}

reload_rho() {
  # Reload through the existing supervisor: never start a second rho daemon
  # inside the container that owns the current Home.
  if ! compose up -d --no-deps --force-recreate --wait --wait-timeout "${CYBROS_WAIT_TIMEOUT:-240}" rho; then
    fail 'Settings were saved but rho did not become healthy. Run ./cybros logs rho, then ./cybros up.'
  fi
}

usage() {
  printf '%s\n' 'Usage: ./cybros init|install|setup [model|telegram]|instructions|up|status|logs [SERVICE]|stop|update [TAG]|connect|rho [ARGS...]|cmctl [ARGS...]|compose [ARGS...]'
  printf '%s\n' 'init initializes configuration only; it never pulls images or starts services.'
  printf '%s\n' 'install initializes missing configuration, pulls images and starts; reruns preserve existing files.'
  printf '%s\n' 'update pulls the configured tag, or selects latest/a Unix timestamp, then starts and checks health.'
  printf '%s\n' 'instructions prints setup and pairing steps without starting services.'
  printf '%s\n' 'setup configures providers, the default model and optional Telegram, then reloads rho.'
  printf '%s\n' 'stop preserves containers and data. compose exposes normal Docker Compose commands.'
}

action=${1:-help}
[ "$#" -eq 0 ] || shift
case "$action" in
  help|--help|-h) usage; exit 0 ;;
  instructions) instructions; exit 0 ;;
esac
prerequisites
case "$action" in
  init)
    initialize
    configured
    printf '\nConfiguration ready. Services have not been started.\n'
    working_directory
    printf '%s\n' '  ./cybros install' 'Use ./cybros up instead if the images are already available locally.'
    printf '%s\n' 'Then run ./cybros setup to configure your model and optional Telegram connection.'
    ;;
  install)
    [ "$#" -eq 0 ] || fail 'install takes no arguments'
    initialize
    configured
    compose pull
    start
    printf '\nCybros services are healthy.\n'
    instructions
    ;;
  up) configured; start ;;
  setup) setup "$@" ;;
  status) configured; compose ps --all ;;
  logs) configured; compose logs --tail 100 "$@" ;;
  stop) configured; compose stop ;;
  update)
    [ "$#" -le 1 ] || fail 'update accepts one tag'
    configured
    if [ "$#" -eq 1 ]; then
      case "$1" in latest) ;; ''|*[!0-9]*) fail 'tag must be latest or a Unix timestamp' ;; esac
      CYBROS_IMAGE_TAG=$1 compose pull
      awk -v tag="$1" '/^CYBROS_IMAGE_TAG=/{print "CYBROS_IMAGE_TAG=\047" tag "\047"; next} {print}' .env > .env.new
      mv .env.new .env
    else
      compose pull
    fi
    start
    ;;
  connect) configured; compose exec -T rho rho connect ;;
  rho) configured; compose exec -T rho rho "$@" ;;
  cmctl) configured; container_exec -e CMCTL_HOME=/var/lib/rho/cmctl rho cmctl "$@" ;;
  compose) configured; compose "$@" ;;
  *) usage >&2; fail "unknown command: $action" ;;
esac
