module CybrosAgent

  module Credentials
    # The application-supplied credential store (see Credentials::Store).
    # Structural on purpose: any object answering these four is a store, which
    # is what lets a test pass a Hash-backed double and rho pass a file.
    interface _Store
      def read: () -> Hash[String, untyped]?
      def write: (Hash[String, untyped] document) -> untyped
      def delete: () -> untyped
      def with_lock: [T] () { () -> T } -> T
      def description: () -> String
    end

    module Store
      module Published
      end
    end

    class StoreError < CybrosAgent::Error
    end

    class NotDurable < CybrosAgent::Error
    end

    class PlaneUnavailable < CybrosAgent::Error
    end

    class ConnectionSuperseded < CybrosAgent::Error
    end

    class OAuth
      VERSION: Integer
      EXPIRY_SKEW_SECONDS: Integer

      # The authority is anything answering rotate(refresh_token:) with a
      # DeviceFlow::Credentials — DeviceFlow::Client is the real one.
      def self.load: (authority: untyped, store: _Store, ?clock: ^() -> Time) -> OAuth?
      def self.issue: (
        credentials: DeviceFlow::Credentials, authority: untyped, store: _Store, ?clock: ^() -> Time
      ) -> OAuth

      class Document < Data
        VERSION: Integer

        attr_reader connection: String
        attr_reader rotation: Integer
        attr_reader refresh_token: String
        attr_reader expires_at: Time
        attr_reader access_token: String?
        attr_reader executor_access_token: String?

        def self.new: (String connection, Integer rotation, String refresh_token, Time expires_at, String? access_token, String? executor_access_token) -> instance
                    | (connection: String, rotation: Integer, refresh_token: String, expires_at: Time, access_token: String?, executor_access_token: String?) -> instance
        def self.[]: (String connection, Integer rotation, String refresh_token, Time expires_at, String? access_token, String? executor_access_token) -> instance
                   | (connection: String, rotation: Integer, refresh_token: String, expires_at: Time, access_token: String?, executor_access_token: String?) -> instance
        def self.members: () -> [:connection, :rotation, :refresh_token, :expires_at, :access_token, :executor_access_token]
        def self.issued: (DeviceFlow::Credentials credentials, connection: String, rotation: Integer, now: Time) -> instance
        def self.read: (_Store store) -> instance?
        def self.from_h: (untyped document, where: String) -> instance

        def members: () -> [:connection, :rotation, :refresh_token, :expires_at, :access_token, :executor_access_token]
        def to_h: () -> Hash[String, untyped]
        def member_plane?: () -> bool
        def executor_plane?: () -> bool
        def rotated: (DeviceFlow::Credentials credentials, now: Time) -> instance
        def persist: (_Store store) -> nil
      end

      include Redacted

      def initialize: (
        authority: untyped, store: _Store, clock: ^() -> Time, document: Document
      ) -> void
      def member_credential: () -> String
      def executor_credential: () -> String
      def member_plane?: () -> bool
      def executor_plane?: () -> bool
      def expires_at: () -> Time
      def rotation: () -> Integer
      def refresh: (?after: Integer?) -> OAuth
      def revoke: () -> nil
      def inspect: () -> String
      def to_s: () -> String
      def pretty_print: (untyped printer) -> void
    end
  end

end
