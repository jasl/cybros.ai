module CybrosAgent

  module Credentials
    type provider = OAuth | APIKey

    def self.load: (authority: untyped, store: _Store, ?clock: ^() -> Time) -> provider?

    # The application-supplied credential store (see Credentials::Store).
    # Structural on purpose: any object answering these four is a store, which
    # is what lets a test pass a Hash-backed double and rho pass a file.
    interface _Store
      def read: () -> Hash[String, untyped]?
      def write: (Hash[String, untyped] document) -> untyped
      def delete: () -> untyped
      def with_lock: [T] () { () -> T } -> T
      def description: () -> String
    end

    module Store
      module Published
      end
    end

    class StoreError < CybrosAgent::Error
    end

    class NotDurable < CybrosAgent::Error
    end

    class PlaneUnavailable < CybrosAgent::Error
    end

    class ConnectionSuperseded < CybrosAgent::Error
    end

    module Document
      VERSION: Integer
      def self.read: (_Store store) -> (OAuth::Document | APIKey::Document)?
      def self.text: (Hash[String, untyped] document, String field, String message) -> String
      def self.optional_text: (Hash[String, untyped] document, String field, String message) -> String?
      def self.refuse_if_superseded: (_Store store, connection: String) -> nil
    end

    class OAuth
      EXPIRY_SKEW_SECONDS: Integer

      # The authority is anything answering rotate(refresh_token:) with a
      # DeviceFlow::Credentials — DeviceFlow::Client is the real one.
      def self.issue: (
        credentials: DeviceFlow::Credentials | ApplicationOAuth::Credentials, authority: untyped, store: _Store, ?clock: ^() -> Time
      ) -> OAuth

      class Document < Data
        attr_reader connection: String
        attr_reader rotation: Integer
        attr_reader refresh_token: String
        attr_reader expires_at: Time
        attr_reader access_token: String?
        attr_reader executor_access_token: String?
        attr_reader platform_access_token: String?

        def self.new: (String connection, Integer rotation, String refresh_token, Time expires_at, String? access_token, String? executor_access_token, ?String? platform_access_token) -> instance
                    | (connection: String, rotation: Integer, refresh_token: String, expires_at: Time, access_token: String?, executor_access_token: String?, ?platform_access_token: String?) -> instance
        def self.[]: (String connection, Integer rotation, String refresh_token, Time expires_at, String? access_token, String? executor_access_token, ?String? platform_access_token) -> instance
                   | (connection: String, rotation: Integer, refresh_token: String, expires_at: Time, access_token: String?, executor_access_token: String?, ?platform_access_token: String?) -> instance
        def self.members: () -> [:connection, :rotation, :refresh_token, :expires_at, :access_token, :executor_access_token, :platform_access_token]
        def self.issued: (DeviceFlow::Credentials | ApplicationOAuth::Credentials credentials, connection: String, rotation: Integer, now: Time) -> instance
        def self.from_h: (Hash[String, untyped] document, where: String) -> instance

        def members: () -> [:connection, :rotation, :refresh_token, :expires_at, :access_token, :executor_access_token, :platform_access_token]
        def to_h: () -> Hash[String, untyped]
        def authentication_kind: () -> "oauth"
        def member_plane?: () -> bool
        def executor_plane?: () -> bool
        def platform_plane?: () -> bool
        def rotated: (DeviceFlow::Credentials | ApplicationOAuth::Credentials credentials, now: Time) -> instance
        def persist: (_Store store) -> nil
      end

      include Redacted

      def initialize: (
        authority: untyped, store: _Store, clock: ^() -> Time, document: Document
      ) -> void
      def member_credential: () -> String
      def executor_credential: () -> String
      def platform_credential: () -> String
      def authentication_kind: () -> "oauth"
      def refreshable?: () -> true
      def member_plane?: () -> bool
      def executor_plane?: () -> bool
      def platform_plane?: () -> bool
      def expires_at: () -> Time
      def rotation: () -> Integer
      def refresh: (?after: Integer?) -> OAuth
      def revoke: () -> nil
      def inspect: () -> String
      def to_s: () -> String
      def pretty_print: (untyped printer) -> void
    end

    class APIKey
      def self.issue: (
        authority: untyped, store: _Store, ?access_token: String?,
        ?executor_access_token: String?, ?platform_access_token: String?
      ) -> APIKey

      class Document < Data
        attr_reader connection: String
        attr_reader access_token: String?
        attr_reader executor_access_token: String?
        attr_reader platform_access_token: String?

        def self.new: (String connection, String? access_token, String? executor_access_token, String? platform_access_token) -> instance
                    | (connection: String, access_token: String?, executor_access_token: String?, platform_access_token: String?) -> instance
        def self.[]: (String connection, String? access_token, String? executor_access_token, String? platform_access_token) -> instance
                   | (connection: String, access_token: String?, executor_access_token: String?, platform_access_token: String?) -> instance
        def self.members: () -> [:connection, :access_token, :executor_access_token, :platform_access_token]
        def self.from_h: (Hash[String, untyped] document, where: String) -> instance

        def members: () -> [:connection, :access_token, :executor_access_token, :platform_access_token]
        def to_h: () -> Hash[String, untyped]
        def authentication_kind: () -> "api_key"
        def member_plane?: () -> bool
        def executor_plane?: () -> bool
        def platform_plane?: () -> bool
        def persist: (_Store store) -> nil
      end

      include Redacted

      def initialize: (authority: untyped, store: _Store, document: Document) -> void
      def authentication_kind: () -> "api_key"
      def refreshable?: () -> false
      def member_credential: () -> String
      def executor_credential: () -> String
      def platform_credential: () -> String
      def member_plane?: () -> bool
      def executor_plane?: () -> bool
      def platform_plane?: () -> bool
      def revoke: () -> nil
      def inspect: () -> String
      def to_s: () -> String
      def pretty_print: (untyped printer) -> void
    end
  end

end
