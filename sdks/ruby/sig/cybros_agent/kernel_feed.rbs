module CybrosAgent

  interface _KernelFeedEvent
    def sequence: () -> Integer
    def cursor: () -> String
  end

  interface _KernelFeedPage[Event]
    def items: () -> Array[Event]
    def watermark: () -> Integer
  end

  interface _KernelFeedSubscription[Event]
    def each: () { (Event event) -> untyped } -> untyped
    def unsubscribe: () -> untyped
  end

  interface _KernelReplay[Event]
    def call: (String? cursor) -> _KernelFeedPage[Event]
  end

  interface _KernelSubscribe[Event]
    def call: () -> _KernelFeedSubscription[Event]
  end

  interface _KernelReplayObserver
    def call: (Integer? head) -> untyped
  end

  class KernelFeed[Event < _KernelFeedEvent]
    class Position < Data
      attr_reader cursor: String?
      attr_reader sequence: Integer

      def self.new: (cursor: String?, sequence: Integer) -> instance
      def self.start: () -> instance
    end

    DEFAULT_MAX_TRANSIENT_RETRIES: Integer
    DEFAULT_RETRY_BACKOFF_SECONDS: Float
    DEFAULT_MAX_BACKOFF_SECONDS: Float
    TRANSIENT_ERRORS: Array[singleton(Api::Error)]
    TRANSIENT_SUBSCRIBE_ERRORS: Array[singleton(StandardError)]

    attr_reader position: Position

    def initialize: (
      replay: _KernelReplay[Event],
      ?subscribe: _KernelSubscribe[Event]?,
      ?position: Position,
      ?after_replay: _KernelReplayObserver?,
      ?sleeper: ^(Numeric seconds) -> untyped,
      ?max_transient_retries: Integer,
      ?retry_backoff: Numeric,
      ?max_backoff: Numeric
    ) -> void
    def each: () { (Event event) -> untyped } -> self
    def rebind: () -> bool
    def attach: (_KernelSubscribe[Event]?) -> bool
    def detach: () -> bool
    def stop: () -> self
  end

end
