module CybrosAgent
  module Api
    class AttentionItem
      attr_reader workspace_public_id: String
      attr_reader run_public_id: String
      attr_reader conversation_public_id: String?
      attr_reader task: Task
    end

    class WorkRunCounts
      attr_reader pending: Integer
      attr_reader running: Integer
      attr_reader paused: Integer
      attr_reader needs_attention: Integer
      attr_reader canceling: Integer
      attr_reader completed: Integer
      attr_reader canceled: Integer
    end

    class WorkCurrent
      attr_reader run_counts: WorkRunCounts
      attr_reader attention_count: Integer
    end

    class WorkTotals
      attr_reader created_runs: Integer
      attr_reader active_answering_agents: Integer
      attr_reader conversation_usage: Platform::UsageCounters
    end

    class WorkPoint
      attr_reader bucket_start_at: String
      attr_reader created_runs: Integer
      attr_reader active_answering_agents: Integer
      attr_reader conversation_usage: Platform::UsageCounters
    end

    class WorkPrevious
      attr_reader from: String
      attr_reader to: String
      attr_reader totals: WorkTotals
    end

    class WorkReport
      attr_reader from: String
      attr_reader to: String
      attr_reader unit: String
      attr_reader as_of: String
      attr_reader workspace_public_id: String?
      attr_reader agent_public_id: String?
      attr_reader current: WorkCurrent
      attr_reader totals: WorkTotals
      attr_reader series: Array[WorkPoint]
      attr_reader previous: WorkPrevious
    end

    class RunCandidate < Data
      attr_reader public_id: String
      attr_reader workspace_public_id: String
      attr_reader conversation_public_id: String
      attr_reader turn_public_id: String
      attr_reader status: String
    end

    class WorkQueries
      def run_candidates: (?agent_public_id: String?, ?after: String?) -> Page[RunCandidate]
      def runs: (?workspace_public_id: String?, ?after: String?, ?limit: Integer?, ?status: untyped, ?attention: String?, ?order: String?, ?from: String?, ?to: String?, ?answering_user_public_id: String?, ?agent_public_id: String?, ?executor_public_id: String?, ?kind: String?) -> Page[Run]
      def attention: (?workspace_public_id: String?, ?view: String?, ?after: String?, ?limit: Integer?, ?order: String?) -> Page[AttentionItem]
      def report: (?workspace_public_id: String?, ?agent_public_id: String?, ?from: String?, ?to: String?, ?unit: String?) -> WorkReport
    end
  end
end
