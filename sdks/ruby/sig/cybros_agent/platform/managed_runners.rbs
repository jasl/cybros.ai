module CybrosAgent
  module Platform
    class ManagedRunner < Data
      attr_reader public_id: String
      attr_reader kind: String
      attr_reader display_name: String
      attr_reader status: String
      attr_reader manager_public_id: String
      attr_reader assignment_scope: String
      attr_reader assignment_agent_public_id: String?
      attr_reader credential_readiness: String
      attr_reader eligible_for_current_user: bool
      attr_reader presence: String
      attr_reader last_seen_at: String?
      attr_reader connected_at: String?
      attr_reader registered_at: String
      def self.new: (public_id: String, kind: String, display_name: String, status: String, manager_public_id: String, assignment_scope: String, assignment_agent_public_id: String?, credential_readiness: String, eligible_for_current_user: bool, presence: String, last_seen_at: String?, connected_at: String?, registered_at: String) -> instance
    end

    class ManagedRunnerDetail < Data
      attr_reader public_id: String
      attr_reader kind: String
      attr_reader display_name: String
      attr_reader status: String
      attr_reader manager_public_id: String
      attr_reader assignment_scope: String
      attr_reader assignment_agent_public_id: String?
      attr_reader credential_readiness: String
      attr_reader eligible_for_current_user: bool
      attr_reader presence: String
      attr_reader last_seen_at: String?
      attr_reader connected_at: String?
      attr_reader registered_at: String
      attr_reader served_tools: Array[Api::ServedTool]
      attr_reader served_documents: Array[Api::ServedDocument]
      attr_reader environment: Hash[String, untyped]
      def self.new: (public_id: String, kind: String, display_name: String, status: String, manager_public_id: String, assignment_scope: String, assignment_agent_public_id: String?, credential_readiness: String, eligible_for_current_user: bool, presence: String, last_seen_at: String?, connected_at: String?, registered_at: String, served_tools: Array[Api::ServedTool], served_documents: Array[Api::ServedDocument], environment: Hash[String, untyped]) -> instance
    end

    class ManagedRunnerPage < Data
      attr_reader items: Array[ManagedRunner]
      attr_reader next_after: String?
      attr_reader measured_at: String
      def self.new: (items: Array[ManagedRunner], next_after: String?, measured_at: String) -> instance
    end

    class ManagedRunnerSnapshot < Data
      attr_reader runner: ManagedRunnerDetail
      attr_reader measured_at: String
      def self.new: (runner: ManagedRunnerDetail, measured_at: String) -> instance
    end

    module ManagedRunnerProjections
      include Api::WorkspaceProjections
      include Api::ExecutorProjections
      include Api::Fields
    end

    class ManagedRunners
      include ManagedRunnerProjections
      PATH: String
      def initialize: (dispatch: Api::_Dispatch) -> void
      def list: (?after: String?, ?limit: Integer?, ?kind: String?, ?status: String?, ?order: String?) -> ManagedRunnerPage
      def fetch: (String public_id) -> ManagedRunnerSnapshot
    end
  end

  class PlatformClient < Api::BaseClient
    def runners: () -> Platform::ManagedRunners
  end
end
