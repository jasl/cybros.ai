{
  "name": "@cybros/agent",
  "version": "0.1.0",
  "description": "Typed server SDK for the Nexus Agent, Executor and Platform APIs",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.15.0",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./realtime": {
      "types": "./dist/realtime.d.ts",
      "import": "./dist/realtime.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "typecheck": "pnpm run build && tsc -p tsconfig.check.json",
    "test": "vitest run",
    "test:node": "node --test test/runtime.mjs",
    "test:package": "tsx scripts/package-smoke.ts",
    "check": "pnpm run typecheck && pnpm run test && pnpm run test:node && pnpm run test:package"
  },
  "peerDependencies": {
    "ws": "^8.18.0"
  },
  "peerDependenciesMeta": {
    "ws": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "ws": "^8.22.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jasl/cybros.ai.git",
    "directory": "sdks/typescript"
  }
}
