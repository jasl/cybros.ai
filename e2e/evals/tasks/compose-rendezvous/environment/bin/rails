#!/bin/sh
case "$1" in
  db:migrate) sleep 2; echo "== 20260901120000 AddCurrencyToEntries: migrating"; echo "-- add_column(:entries, :currency, :string)"; echo "== AddCurrencyToEntries: migrated (0.0123s)";;
  db:seed) sleep 3; echo "Seeded 3 accounts, 12 entries";;
  db:schema:dump) echo "create_table \"entries\" do |t|"; echo "  t.string \"currency\", default: \"USD\", null: false"; echo "end";;
  *) echo "usage: bin/rails <db:migrate|db:seed|db:schema:dump>" >&2; exit 2;;
esac
