require "rake"

# Each lane resolves only its own dependency closure and owns its own worlds.
%w[protocol products].each do |lane|
  desc "Run #{lane} E2E in its independent bundle"
  task lane do
    env = ENV.keys.grep(/\ABUNDLE/).to_h { |key| [key, nil] }
    env.merge!("BUNDLE_GEMFILE" => File.expand_path("#{lane}/Gemfile", __dir__),
      "BUNDLE_FROZEN" => "true", "RUBYOPT" => nil, "RUBYLIB" => nil)
    sh env, Gem.ruby, Gem.bin_path("bundler", "bundle"), "exec", "rake",
      chdir: File.expand_path(lane, __dir__)
  end
end

task default: %i[protocol products]
